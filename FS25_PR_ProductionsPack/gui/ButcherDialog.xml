<?xml version="1.0" encoding="utf-8" standalone="no"?>

<GUI onCreate="onCreate" onOpen="onOpen" onClose="onClose">

    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="prb_dialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="fs25_dialogContentContainer" id="contentArea">

            <Text id="titleText"
                  profile="fs25_dialogTitle"
                  text="THE BUTCHER BARN"
                  position="0px -8px" />

            <Text name="prbHelperText"
                  profile="prb_helperText"
                  position="0px -30px"
                  text="Use ←/→ arrows, number keys or numpad to change animal count. Default: Max Allowed.&#10;Hold SHIFT with arrows to adjust by ×10." />

            <!-- Left column -->
            <Text id="barnInfoTitle"    profile="prb_dialogText" text="BARN INFO"    position="-160px -110px" />

            <Text id="capacityLabel"   profile="prb_dialogText" text="Barn Capacity:"   position="-160px -137px" />
            <Text id="capacityValue"   profile="prb_dialogText" text="0"                position="20px -137px" />

            <Text id="storedLabel"     profile="prb_dialogText" text="Stored in Barn:"  position="-160px -159px" />
            <Text id="storedValue"     profile="prb_dialogText" text="0"                position="20px -159px" />

            <Text id="availableLabel"  profile="prb_dialogText" text="Available Space:" position="-160px -181px" />
            <Text id="availableValue"  profile="prb_dialogText" text="0"                position="20px -181px" />

            <!-- Right column -->
            <Text id="trailerInfoTitle" profile="prb_dialogText" text="TRAILER INFO" position="150px -110px" />

            <Text id="trailerLabel"    profile="prb_dialogText" text="Animals in Trailer:" position="150px -137px" />
            <Text id="trailerValue"    profile="prb_dialogText" text="0"                   position="370px -137px" />

            <Text id="animalTypeLabel" profile="prb_dialogText" text="Animal Type:"        position="150px -159px" />
            <Text id="animalTypeValue" profile="prb_dialogText" text="COW"                 position="370px -159px" />

            <Text id="invalidAgeLabel" profile="prb_dialogText" text="Invalid Age Count:"  position="150px -181px" />
            <Text id="invalidAgeValue" profile="prb_dialogText" text="0"                   position="370px -181px" />

            <Text id="amountLabel"     profile="prb_dialogText" text="Animal count:"       position="150px -215px" />
            <Text id="amountLeft"      profile="prb_dialogText" text="←"                   position="310px -215px" />
            <Text id="amountValue"     profile="prb_dialogText" text="0"                   position="335px -215px" />
            <Text id="amountRight"     profile="prb_dialogText" text="→"                   position="370px -215px" />

            <Text id="deliveredWeightLabel" profile="prb_dialogText" text="Delivered Weight:" position="150px -237px" />
            <Text id="deliveredWeightValue" profile="prb_dialogText" text="0 kg"              position="330px -237px" />

            <Text id="meatQualityLabel"     profile="prb_dialogText" text="Meat Quality:"     position="150px -259px" />
            <Text id="meatQualityValue"     profile="prb_dialogText" text="0 %"               position="330px -259px" />

            <Text id="breedBonusLabel"      profile="prb_dialogText" text="Breed Bonus:"      position="150px -281px" />
            <Text id="breedBonusValue"      profile="prb_dialogText" text="+0%"               position="330px -281px" />

        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox">
            <Button id="okButton"
                    profile="buttonOK"
                    text="$l10n_button_ok"
                    onClick="onClickOk" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button id="backButton"
                    profile="buttonBack"
                    text="$l10n_button_back"
                    onClick="onClickBack" />
        </BoxLayout>

    </GuiElement>
</GUI>