<?xml version="1.0" encoding="utf-8" standalone="no"?>

<GUI onCreate="onCreate" onOpen="onOpen" onClose="onClose">

    <GuiElement profile="newLayer" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="prb_dialogBg" id="dialogElement">
        <ThreePartBitmap profile="fs25_dialogBgMiddleSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgTopSmall"/>
        <ThreePartBitmap profile="fs25_dialogBgBottom"/>

        <GuiElement profile="fs25_dialogContentContainer" id="contentArea">

            <Text id="titleText"
                  profile="fs25_dialogTitle"
                  text="THE BUTCHER BARN"
                  position="0px -8px" />

            <Text name="prbHelperText"
                  profile="prb_helperText"
                  position="0px -32px"
                  text="Use ←/→ arrows, number keys or numpad to change animal count. Default: Max Allowed.&#10;Hold SHIFT with arrows to adjust by ×10." />

            <Text id="barnInfoTitle"    profile="rvb_dialogText" text="BARN INFO"    position="-320px -70px" />
            <Text id="trailerInfoTitle" profile="rvb_dialogText" text="TRAILER INFO" position="40px -70px" />

            <Text id="capacityLabel"   profile="rvb_dialogText" text="Barn Capacity:"   position="-320px -98px" />
            <Text id="capacityValue"   profile="rvb_dialogText" text="0"                position="-150px -98px" />

            <Text id="storedLabel"     profile="rvb_dialogText" text="Stored in Barn:"  position="-320px -122px" />
            <Text id="storedValue"     profile="rvb_dialogText" text="0"                position="-150px -122px" />

            <Text id="availableLabel"  profile="rvb_dialogText" text="Available Space:" position="-320px -146px" />
            <Text id="availableValue"  profile="rvb_dialogText" text="0"                position="-150px -146px" />

            <Text id="trailerLabel"    profile="rvb_dialogText" text="Animals in Trailer:" position="40px -98px" />
            <Text id="trailerValue"    profile="rvb_dialogText" text="0"                   position="260px -98px" />

            <Text id="animalTypeLabel" profile="rvb_dialogText" text="Animal Type:"        position="40px -122px" />
            <Text id="animalTypeValue" profile="rvb_dialogText" text="COW"                 position="260px -122px" />

            <Text id="invalidAgeLabel" profile="rvb_dialogText" text="Invalid Age Count:"  position="40px -146px" />
            <Text id="invalidAgeValue" profile="rvb_dialogText" text="0"                   position="260px -146px" />

            <Text id="amountLabel"     profile="rvb_dialogText" text="Animal count:"       position="40px -180px" />
            <Text id="amountLeft"      profile="rvb_dialogText" text="←"                   position="200px -180px" />
            <Text id="amountValue"     profile="rvb_dialogText" text="0"                   position="225px -180px" />
            <Text id="amountRight"     profile="rvb_dialogText" text="→"                   position="260px -180px" />

            <Text id="deliveredWeightLabel" profile="rvb_dialogText" text="Delivered Weight:" position="40px -204px" />
            <Text id="deliveredWeightValue" profile="rvb_dialogText" text="0 kg"              position="220px -204px" />

            <Text id="meatQualityLabel"     profile="rvb_dialogText" text="Meat Quality:"     position="40px -228px" />
            <Text id="meatQualityValue"     profile="rvb_dialogText" text="0 %"               position="220px -228px" />

            <Text id="breedBonusLabel"      profile="rvb_dialogText" text="Breed Bonus:"      position="40px -252px" />
            <Text id="breedBonusValue"      profile="rvb_dialogText" text="+0%"               position="220px -252px" />

        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox">
            <Button id="okButton"  profile="buttonOK"  text="$l10n_button_ok"  onClick="onClickOk" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button id="backButton" profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" />
        </BoxLayout>

    </GuiElement>
</GUI>