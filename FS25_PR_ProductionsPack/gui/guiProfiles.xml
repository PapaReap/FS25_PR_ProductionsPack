<?xml version="1.0" encoding="utf-8" standalone="no"?>

<GUIProfiles>

    <Profile name="prb_dialogBg" extends="baseReference" with="pivotMiddleCenter">
        <size value="900px 540px" />
        <color value="$preset_colorBlack80" />
        <Variant name="mobile">
            <size value="1400px 580px" />
            <position value="0px 54px" />
            <hasFrame value="false" />
            <color value="$preset_colorBlack80" />
        </Variant>
    </Profile>

    <Profile name="prb_dialogText" extends="fs25_textDefault" with="anchorTopCenter">
        <size value="380px 18px" />
        <textSize value="14px" />
        <textMaxNumLines value="2" />
        <textAlignment value="left" />
        <textLineHeightScale value="1.2" />
        <textVerticalAlignment value="top" />
        <Variant name="mobile">
            <textSize value="32px" />
            <size value="600px 24px" />
        </Variant>
    </Profile>

    <Profile name="prb_helperText" extends="prb_dialogText">
        <size value="700px 16px" />
        <textSize value="12px" />
        <textAlignment value="center" />
        <textVerticalAlignment value="top" />
        <textLineHeightScale value="1.1" />
        <textMaxNumLines value="3" />
        <textColor value="1 0.85 0 1"/>
    </Profile>

<Profile name="prb_arrowButton" extends="baseReference" with="anchorTopCenter">
    <size value="60px 28px" />
    <textSize value="16px" />
    <textAlignment value="center" />
    <textVerticalAlignment value="middle" />
    <textColor value="1 1 1 1" />
    <color value="0.15 0.15 0.15 1" />
</Profile>

</GUIProfiles>