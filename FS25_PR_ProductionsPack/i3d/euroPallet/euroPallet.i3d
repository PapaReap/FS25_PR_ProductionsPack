<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="euroPallet" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">

  <Files>
    <File fileId="1" filename="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.png" />
    <File fileId="5" filename="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.png" />
    <File fileId="2" filename="$data/objects/pallets/shared/euroPallet/euroPallet_normal.png" />
    <File fileId="3" filename="$data/objects/pallets/shared/euroPallet/euroPallet_specular.png" />
    <File fileId="4" filename="$data/shaders/placeableShader.xml" />
  </Files>

  <Materials>
    <Material name="lambert1" materialId="2" diffuseColor="0.5 0.5 0.5 1">
    </Material>
    <Material name="euroPalletNew_mat" materialId="1" customShaderId="4" customShaderVariation="customDiffuseBlend">
      <CustomParameter name="blendScale" value="0.0"/>
      <Custommap name="mCustomDiffuse" fileId="5"/>
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="euroPallet.i3d.shapes">
  </Shapes>

  <Scene>
    <Shape name="euroPallet_vis" shapeId="1" castsShadows="true" receiveShadows="true" materialIds="1" clipDistance="200" nodeId="1">
      <Shape name="tensionBeltMesh" shapeId="2" castsShadows="true" receiveShadows="true" nonRenderable="true" materialIds="2" nodeId="2"/>
    </Shape>
  </Scene>

  <UserAttributes>
  </UserAttributes>
</i3D>
