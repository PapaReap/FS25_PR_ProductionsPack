<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_distributer</name>
        <functions>
            <function>$l10n_function_distributer</function>
        </functions>
        <image>store/store_distributer.dds</image>
        <price>1000</price>
        <dailyUpkeep>5</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Greenhouse</tab>
        </brush>
        <vertexBufferMemoryUsage>244480</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>62976</indexBufferMemoryUsage>
        <textureMemoryUsage>3538944</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/placeables/openAirGarden/distributer.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>
        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="hotspotMarker" teleportNode="teleportNode"/>
    </hotspots>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
        <splines>
            <spline node="aiLoadingSpline" />
        </splines>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="water" name="%s" params="$l10n_fillType_water" cyclesPerHour="7" costsPerActiveHour="0.01">
                <inputs>
                    <input fillType="WATER" amount="1000" />
                </inputs>
                <outputs>
                    <output fillType="WATER" amount="1000" />
                </outputs>
            </production>

            <production id="seeds" name="%s" params="$l10n_fillType_seeds" cyclesPerHour="1" costsPerActiveHour="0.01">
                <inputs>
                    <input fillType="SEEDS" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="SEEDS" amount="100" />
                </outputs>
            </production>

            <production id="fertilizer" name="%s" params="$l10n_fillType_fertilizer" cyclesPerHour="1" costsPerActiveHour="0.01">
                <inputs>
                    <input fillType="FERTILIZER" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="FERTILIZER" amount="100" />
                </outputs>
            </production>

            <production id="manure" name="%s" params="$l10n_fillType_manure" cyclesPerHour="5" costsPerActiveHour="0.01">
                <inputs>
                    <input fillType="MANURE" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="MANURE" amount="100" />
                </outputs>
            </production>

            <production id="manureFertilizer" name="%s %s" params="$l10n_fillType_manure|$l10n_fillType_fertilizer" cyclesPerHour="50" costsPerActiveHour="0.01">
                <inputs>
                    <input fillType="MANURE" amount="1000" />
                </inputs>
                <outputs>
                    <output fillType="FERTILIZER" amount="200" />
                </outputs>
            </production>

        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WATER"          capacity="2500000" />
            <capacity fillType="SEEDS"          capacity="500000" />
            <capacity fillType="FERTILIZER"     capacity="500000" />
            <capacity fillType="MANURE"         capacity="500000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="aiNodeUnlading" fillTypes="WATER SEEDS FERTILIZER MANURE">
                <palletTrigger triggerNode="palletTrigger" deleteLitersPerSecond="10000" aiNode="aiNodeUnlading" fillTypeCategories="SEEDS FERTILIZER" />
            </unloadTrigger>        

            <simpleFillplane fillTypes="MANURE" node="manureFillplane" />
            <simpleFillplane fillTypes="FERTILIZER" node="fertilizerFillplane" />

        </sellingStation>

        <loadingStation supportsExtension="false" >
            <loadTrigger triggerNode="loadingTrigger" fillTypes="WATER SEEDS FERTILIZER MANURE" fillLitersPerSecond="2000" aiNode="aiNodeLoading">
            </loadTrigger>
        </loadingStation>

        <playerTrigger node="playerTrigger" />

    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="markerLoading"   filename="$data/shared/assets/marker/markerIconLoad.i3d" adjustToGround="true" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
        <triggerMarker node="markerUnloading" filename="$data/shared/assets/marker/markerIconUnload.i3d"  adjustToGround="true" />
    </triggerMarkers>

    <solarPanels>
        <solarPanelsConfigurations title="$l10n_buildingConfiguration">
            <solarPanelsConfiguration name="$l10n_woodenHut" isActive="true" >
                <objectChange node="woodenHut" visibilityActive="true"/>
                <objectChange node="plasticBox" visibilityActive="false"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_container" isActive="false">
                <objectChange node="woodenHut" visibilityActive="false"/>
                <objectChange node="plasticBox" visibilityActive="true"/>
            </solarPanelsConfiguration>
        </solarPanelsConfigurations>
    </solarPanels>

    <colorConfigurations price="0" useDefaultColors="true">
        <node node="liquidsSilo" />
        <node node="plasticStorage" />
        <node node="plasticRoof" />
        <colorConfiguration color="0.01 0.053 0.031" name="$l10n_GreenDark" />
        <colorConfiguration color="0.38 0.22 0.14" name="$l10n_BrownMedium" />
        <colorConfiguration color="0.4125 0.2195 0.0742" name="$l10n_BrownMedium2"/>
        <colorConfiguration color="0.397 0.235 0.117" name="$l10n_BrownLight"/>
        <colorConfiguration color="0.0666 0.0497 0.0369" name="$l10n_BrownDark"/>
        <colorConfiguration color="0.753 0.515 0.314" name="$l10n_Beige"/>
        <colorConfiguration color="0.5 0.18 0.117" name="$l10n_BrownRed"/>
        <colorConfiguration color="0.35 0.06 0.05" name="$l10n_RedMatte"/>
        <colorConfiguration color="0.3419 0.3095 0.1274" name="$l10n_OliveBeige"/>
        <colorConfiguration color="0.25 0.39 0.25" name="$l10n_BrightGreen"/>
        <colorConfiguration color="0.098 0.184 0.08" name="$l10n_GreenMedium"/>
        <colorConfiguration color="0.05 0.18 0.2" name="$l10n_Petrol"/>
        <colorConfiguration color="0.296 0.337 0.479" name="$l10n_BrightLilac"/>
        <colorConfiguration color="0.09 0.117 0.216" name="$l10n_Lilac"/>
    </colorConfigurations>

    <i3dMappings>
        <i3dMapping id="clearArea1Start" node="0>1|0" />
        <i3dMapping id="clearArea1Width" node="0>1|0|0" />
        <i3dMapping id="clearArea1Height" node="0>1|0|1" />
        <i3dMapping id="levelArea1Start" node="0>2|0" />
        <i3dMapping id="levelArea1Width" node="0>2|0|0" />
        <i3dMapping id="levelArea1Height" node="0>2|0|1" />
        <i3dMapping id="indoorArea1Start" node="0>4|0" />
        <i3dMapping id="indoorArea1Width" node="0>4|0|0" />
        <i3dMapping id="indoorArea1Height" node="0>4|0|1" />
        <i3dMapping id="testArea1Start" node="0>5|0" />
        <i3dMapping id="testArea1End" node="0>5|0|0" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>6|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>6|0|0" />
        <i3dMapping id="infoTrigger" node="0>7" />
        <i3dMapping id="teleportNode" node="0>10" />
        <i3dMapping id="hotspotMarker" node="0>10" />
        <i3dMapping id="exactFillRootNode" node="0>11|0" />
        <i3dMapping id="palletTrigger" node="0>11|0|0" />
        <i3dMapping id="markerUnloading" node="0>11|0|1" />
        <i3dMapping id="aiNodeUnlading" node="0>11|1" />
        <i3dMapping id="playerTrigger" node="0>12|0" />
        <i3dMapping id="playerTriggerMarker" node="0>12|0|0" />

        <i3dMapping id="loadingTrigger" node="0>13|0|0" />
        <i3dMapping id="markerLoading" node="0>13|0|0|0" />
        <i3dMapping id="aiNodeLoading" node="0>13|0|0|1" />
        <i3dMapping id="aiLoadingSpline" node="0>13|1" />

        <i3dMapping id="plasticBox" node="0>14|0" />
        <i3dMapping id="woodenHut" node="0>14|1" />
        <i3dMapping id="manureFillplane" node="0>14|1|3" />
        <i3dMapping id="fertilizerFillplane" node="0>14|1|4" />

        <i3dMapping id="liquidsSilo" node="0>0|0" />
        <i3dMapping id="plasticStorage" node="0>14|0|0" />
        <i3dMapping id="plasticRoof" node="0>14|1|0" />
    </i3dMappings>
</placeable>
