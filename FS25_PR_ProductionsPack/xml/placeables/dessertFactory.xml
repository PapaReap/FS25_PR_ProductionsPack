                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights> -->

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="creme_caramel" name="$l10n_fillType_creme_caramel" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="EGG" amount="15" />
                    <input fillType="MILK" amount="25" />
                    <input fillType="SUGAR" amount="15" />
                    <input fillType="EMPTYPALLET" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="CREME_CARAMEL" amount="50" />
                </outputs>
            </production>

            <production id="strawberry_sorbet" name="$l10n_fillType_strawberry_sorbet" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="STRAWBERRY" amount="35" />
                    <input fillType="WATER" amount="15" />
                    <input fillType="SUGAR" amount="7" />
                    <input fillType="EMPTYPALLET" amount="55" />
                </inputs>
                <outputs>
                    <output fillType="STRAWBERRY_SORBET" amount="55" />
                </outputs>
            </production>

            <production id="chocolate_mousse" name="$l10n_fillType_chocolate_mousse" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="CHOCOLATE" amount="20" />
                    <input fillType="EGG" amount="30" />
                    <input fillType="EMPTYPALLET" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="CHOCOLATE_MOUSSE" amount="50" />
                </outputs>
            </production>

            <production id="chocolate_brownie" name="$l10n_fillType_chocolate_brownie" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="BUTTER" amount="9" />
                    <input fillType="CHOCOLATE" amount="10" />
                    <input fillType="SUGAR" amount="16" />
                    <input fillType="FLOUR" amount="7" />
                    <input fillType="EGG" amount="8" />
                    <input fillType="EMPTYPALLET" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="CHOCOLATE_BROWNIE" amount="50" />
                </outputs>
            </production>

            <production id="chocolate_fondant" name="$l10n_fillType_chocolate_fondant" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="BUTTER" amount="12" />
                    <input fillType="CHOCOLATE" amount="10" />
                    <input fillType="SUGAR" amount="16" />
                    <input fillType="FLOUR" amount="10" />
                    <input fillType="EGG" amount="20" />
                    <input fillType="EMPTYPALLET" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="CHOCOLATE_FONDANT" amount="50" />
                </outputs>
            </production>

            <production id="strawberry_jam" name="$l10n_fillType_strawberry_jam" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="STRAWBERRY" amount="25" />
                    <input fillType="SUGAR" amount="20" />
                    <input fillType="EMPTYPALLET" amount="45" />
                </inputs>
                <outputs>
                    <output fillType="STRAWBERRY_JAM" amount="45" />
                </outputs>
            </production>

            <production id="grape_jam" name="$l10n_fillType_grape_jam" cyclesPerHour="25" costsPerActiveHour="10">
                <inputs>
                    <input fillType="GRAPE" amount="25" />
                    <input fillType="SUGAR" amount="20" />
                    <input fillType="EMPTYPALLET" amount="45" />
                </inputs>
                <outputs>
                    <output fillType="GRAPE_JAM" amount="45" />
                </outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="MILK WATER GRAPE"/>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="EGG SUGAR CHOCOLATE MILK WATER STRAWBERRY BUTTER FLOUR GRAPE EMPTYPALLET"/>
        </sellingStation>

        <palletSpawner node="palletSpawner">
            <spawnPlaces>
                <spawnPlace startNode="palletSpawnerArea3Start" fillTypes="CREME_CARAMEL STRAWBERRY_SORBET CHOCOLATE_MOUSSE CHOCOLATE_FONDANT CHOCOLATE_BROWNIE STRAWBERRY_JAM GRAPE_JAM"/>
                <spawnPlace startNode="palletSpawnerArea4Start" fillTypes="CREME_CARAMEL STRAWBERRY_SORBET CHOCOLATE_MOUSSE CHOCOLATE_FONDANT CHOCOLATE_BROWNIE STRAWBERRY_JAM GRAPE_JAM"/>
            </spawnPlaces>
        </palletSpawner>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="EGG" capacity="150000" /> <!-- 1400L/380kg -->
            <capacity fillType="MILK" capacity="60000" /> <!-- 1000L/1100kg -->
            <capacity fillType="SUGAR" capacity="150000" /> <!-- 1000L/950kg -->
            <capacity fillType="WATER" capacity="80000" /> <!-- 1000L/950kg -->
            <capacity fillType="STRAWBERRY" capacity="150000" /> <!-- 1000L/950kg -->
            <capacity fillType="GRAPE" capacity="150000" /> <!-- 1000L/950kg -->
            <capacity fillType="CHOCOLATE" capacity="100000" /> <!-- 1000L/950kg -->
            <capacity fillType="BUTTER" capacity="50000" /> <!-- 1000L/950kg -->
            <capacity fillType="FLOUR" capacity="40000" /> <!-- 1000L/950kg -->
            <capacity fillType="EMPTYPALLET"    capacity="200000" />

            <capacity fillType="CREME_CARAMEL" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="STRAWBERRY_SORBET" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="CHOCOLATE_MOUSSE" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="CHOCOLATE_FONDANT" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="CHOCOLATE_BROWNIE" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="STRAWBERRY_JAM" capacity="50000" /> <!-- 1000L/1100kg -->
            <capacity fillType="GRAPE_JAM" capacity="50000" /> <!-- 1000L/1100kg -->
        </storage>

        <playerTrigger node="playerTrigger" />
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes_palletSpawnArea" />
        <triggerMarker node="warningStripes_palletUnloadArea" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="spawnTriggerMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d" adjustToGround="true" />
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="DessertFactory" node="0>" />
