<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="extendedProductionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
            $l10n_store_theButcherBarn
        </name>
        <functions>
            <function>$l10n_function_theButcherBarn</function>
        </functions>
        <image>store/theButcherBarn.dds</image>
        <price>360000</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
    </storeData>

    <base>
        <filename>i3d/theButcherBarn.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="largeImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
        <indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="teleportNode" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="warningStripes"  adjustToGround="true" />
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
		
        <triggerMarker node="loadingZoneTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconShopping.i3d"/>
		
    </triggerMarkers>

    <animatedObjects>
        <animatedObject saveId="gate01" >
            <animation duration="3.5">
                <part node="gate01_doorLeft">
                    <keyFrame time="0" translation="1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"  />
                </part>
                <part node="gate01_doorRight">
                    <keyFrame time="0" translation="-1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerGate01" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="gate01_doorLeft" template="slidingGateWoodLoop" />
                <posEnd linkNode="gate01_doorLeft" template="woodDoorOpen" />
                <negEnd linkNode="gate01_doorLeft" template="woodDoorClose" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="gate02" >
            <animation duration="3.5">
                <part node="gate02_doorLeft">
                    <keyFrame time="0" translation="1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"/>
                </part>
                <part node="gate02_doorRight">
                    <keyFrame time="0" translation="-1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerGate02" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="gate02_doorLeft" template="slidingGateWoodLoop" />
                <posEnd linkNode="gate02_doorLeft" template="woodDoorOpen" />
                <negEnd linkNode="gate02_doorLeft" template="woodDoorClose" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="gate03" >
            <animation duration="3.5">
                <part node="gate03_doorLeft">
                    <keyFrame time="0" translation="-1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"  />
                </part>
                <part node="gate03_doorRight">
                    <keyFrame time="0" translation="1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerGate03" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="gate03_doorRight" template="slidingGateWoodLoop" />
                <posEnd linkNode="gate03_doorRight" template="woodDoorOpen" />
                <negEnd linkNode="gate03_doorRight" template="woodDoorClose" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="gate04" >
            <animation duration="3.5">
                <part node="gate04_doorLeft">
                    <keyFrame time="0" translation="-1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"  />
                </part>
                <part node="gate04_doorRight">
                    <keyFrame time="0" translation="1.186 0 0"/>
                    <keyFrame time="1" translation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerGate04" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="gate04_doorRight" template="slidingGateWoodLoop" />
                <posEnd linkNode="gate04_doorRight" template="woodDoorOpen" />
                <negEnd linkNode="gate04_doorRight" template="woodDoorClose" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="door01" >
            <animation duration="1.5">
                <part node="door01">
                    <keyFrame time="0.25" rotation="0 0 0"/>
                    <keyFrame time="1.25" rotation="0 95 0"/>
                </part>
                <part node="door01Opener">
                    <keyFrame time="0.00" rotation="0 0 0"/>
                    <keyFrame time="0.25" rotation="0 0 -25"/>
                    <keyFrame time="0.75" rotation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerDoor01" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="door01" template="woodDoorSqueaksSmall" />
                <posEnd linkNode="door01" template="woodDoorOpen" />
                <negEnd linkNode="door01" template="woodDoorCloseRandom" />
            </sounds>
        </animatedObject>

        <animatedObject saveId="door02" >
            <animation duration="1.5">
                <part node="door02">
                    <keyFrame time="0.25" rotation="0 0 0"/>
                    <keyFrame time="1.25" rotation="0 95 0"/>
                </part>
                <part node="door02Opener">
                    <keyFrame time="0.00" rotation="0 0 0"/>
                    <keyFrame time="0.25" rotation="0 0 25"/>
                    <keyFrame time="0.75" rotation="0 0 0"/>
                </part>
            </animation>
            <controls triggerNode="triggerDoor02" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="door01" template="woodDoorSqueaksSmall" />
                <posEnd linkNode="door01" template="woodDoorOpen" />
                <negEnd linkNode="door01" template="woodDoorCloseRandom" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <extendedProductionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="PIG" name="Pig Processing" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="PIGMEAT" amount="1" />
                    <input fillType="EMPTYPALLET" amount="285" />
                </inputs>
                <outputs>
                    <output fillType="HAM" amount="105" />
                    <output fillType="PORK" amount="75" />
                    <output fillType="BACON" amount="45" />
                    <output fillType="SAUSAGE" amount="30" />
                    <output fillType="PEPPERONI" amount="30" />
                </outputs>
            </production>

            <production id="COW" name="Cow Processing" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="COWMEAT" amount="1" />
                    <input fillType="EMPTYPALLET" amount="650" />
                </inputs>
                <outputs>
                    <output fillType="GROUNDBEEF" amount="220" />
                    <output fillType="STEAK" amount="220" />
                    <output fillType="SAUSAGE" amount="105" />
                    <output fillType="PEPPERONI" amount="105" />
                </outputs>
            </production>

            <production id="SHEEP" name="Sheep Processing" cyclesPerHour="1" costsPerActiveHour="3">
                <inputs>
                    <input fillType="SHEEPMEAT" amount="1" />
                    <input fillType="EMPTYPALLET" amount="300" />
                </inputs>
                <outputs>
                    <output fillType="MUTTON" amount="150" />
                    <output fillType="CHEVON" amount="150" />
                </outputs>
            </production>

            <production id="CHICKEN" name="Chicken Processing" cyclesPerHour="15" costsPerActiveHour="3">
                <inputs>
                    <input fillType="POULTRY" amount="1" />
                    <input fillType="EMPTYPALLET" amount="35" />
                </inputs>
                <outputs>
                    <output fillType="CHICKENFILLET" amount="35" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="POULTRY"        capacity="1000" />
            <capacity fillType="COWMEAT"        capacity="150" />
            <capacity fillType="PIGMEAT"        capacity="250" />
            <capacity fillType="SHEEPMEAT"      capacity="200" />
            <capacity fillType="EMPTYPALLET"    capacity="100000" />

            <capacity fillType="BACON"          capacity="25000" />
            <capacity fillType="CHEVON"         capacity="25000" />
            <capacity fillType="CHICKENFILLET"  capacity="25000" />
            <capacity fillType="GROUNDBEEF"     capacity="25000" />
            <capacity fillType="HAM"            capacity="25000" />
            <capacity fillType="MUTTON"         capacity="25000" />
            <capacity fillType="PEPPERONI"      capacity="25000" />
            <capacity fillType="PORK"           capacity="25000" />
            <capacity fillType="SAUSAGE"        capacity="25000" />
            <capacity fillType="STEAK"          capacity="25000" />
        </storage>

        <animalInput triggerNode="animalTrigger" unloadConfirmationText="message_unloadAnimalConfirmation" unloadSuccessText="message_unloadAnimalSuccess" moveButtonText="button_moveAnimal" animalMinimumAgeText="message_animalTooYoung" animalMaximumAgeText="message_animalTooOld">
            <animal type="PIG" fillType="PIGMEAT" minimumAge="6" maximumAge="24"/>
            <animal type="COW" fillType="COWMEAT" minimumAge="18" maximumAge="40"/>
            <animal type="SHEEP" fillType="SHEEPMEAT" minimumAge="14" maximumAge="28"/>
            <animal type="CHICKEN" fillType="POULTRY" minimumAge="6" maximumAge="30"/>
        </animalInput>

        <sellingStation node="sellingStation" stationName="The Butcher Barn" appearsOnStats="false" allowMissions="false" supportsExtension="true" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="PIGMEAT COWMEAT SHEEPMEAT POULTRY">
            </unloadTrigger>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="EMPTYPALLET"/>
        </sellingStation>

        <palletSpawner node="palletSpawner">
            <spawnPlaces>
                <spawnPlace startNode="spawnSpace1start" />
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle template="carpenterIdle"  volumeScale="1" linkNode="0>" />
            <active template="carpenterWork"  volumeScale="2" linkNode="0>" />
        </sounds>
    </extendedProductionPoint>

    <i3dMappings>
        <i3dMapping id="theButcherBarn" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />

        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
