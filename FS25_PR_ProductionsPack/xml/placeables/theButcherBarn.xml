        <i3dMapping id="triggerGate02" node="0>7|11" />
        <i3dMapping id="triggerGate03" node="0>7|12" />
        <i3dMapping id="triggerGate04" node="0>7|13" />
        <i3dMapping id="triggerDoor01" node="0>7|14" />
        <i3dMapping id="triggerDoor02" node="0>7|15" />

        <i3dMapping id="sellingStation" node="0>8" />
        <i3dMapping id="unloadTrigger" node="0>8|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>8|1" />
        <i3dMapping id="teleportNode" node="0>8|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>8|3" />
        <i3dMapping id="animalTrigger" node="0>8|4" />
        <i3dMapping id="butcherTrigger" node="0>8|5" />
        <i3dMapping id="palletTrigger" node="0>8|6" />

        <i3dMapping id="playerTrigger" node="0>9" />
        <i3dMapping id="playerTriggerMarker" node="0>9|0" />

        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="spawnSpace1start" node="0>10|0" />
        <i3dMapping id="spawnSpace1end" node="0>10|0|0" />

        <i3dMapping id="warningStripes" node="0>15" />
		
        <i3dMapping id="loadingZoneTrigger" node="0>16" />
		<i3dMapping id="loadingZoneTriggerMarker" node="0>16|0" />
		
    </i3dMappings>
</placeable>