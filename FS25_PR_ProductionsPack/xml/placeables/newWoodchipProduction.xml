    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="mdfBoards" name="$l10n_fillType_mdfBoards" cyclesPerHour="14" costsPerActiveHour="1"><!-- 16,800 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="WATER" amount="10" />
                    <input fillType="EMPTYPALLET" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="MDFBOARDS" amount="50" />
                </outputs>
            </production>

            <production id="osbBoards" name="$l10n_fillType_osbBoards" cyclesPerHour="15" costsPerActiveHour="1"><!-- 23,400 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="WATER" amount="10" />
                    <input fillType="EMPTYPALLET" amount="65" />
                </inputs>
                <outputs>
                    <output fillType="OSBBOARDS" amount="65" />
                </outputs>
            </production>

            <production id="darkBrownWoodMulch" name="$l10n_fillType_woodMulchDarkBrown" cyclesPerHour="18" costsPerActiveHour="1"><!-- 43,200 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="EMPTYPALLET" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="WOODMULCHDARKBROWN" amount="100" />
                </outputs>
            </production>
            <production id="naturalWoodMulch" name="$l10n_fillType_woodMulchNatural" cyclesPerHour="18" costsPerActiveHour="1"><!-- 43,200 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="EMPTYPALLET" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="WOODMULCHNATURAL" amount="100" />
                </outputs>
            </production>
            <production id="redWoodMulch" name="$l10n_fillType_woodMulchRed" cyclesPerHour="18" costsPerActiveHour="1"><!-- 43,200 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="EMPTYPALLET" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="WOODMULCHRED" amount="100" />
                </outputs>
            </production>

            <production id="fireLogs" name="$l10n_fillType_fireLogs" cyclesPerHour="10" costsPerActiveHour="1"><!-- 14,400 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="DIESEL" amount="10" />
                    <input fillType="WATER" amount="5" />
                    <input fillType="EMPTYPALLET" amount="60" />
                </inputs>
                <outputs>
                    <output fillType="FIRELOGS" amount="60" />
                </outputs>
            </production>
            <production id="smokerPellets" name="$l10n_fillType_smokerPellets" cyclesPerHour="12" costsPerActiveHour="1"><!-- 12,960 per day -->
                <inputs>
                    <input fillType="WOODCHIPS" amount="100" />
                    <input fillType="WATER" amount="10" />
                    <input fillType="EMPTYPALLET" amount="45" />
                </inputs>
                <outputs>
                    <output fillType="SMOKERPELLETS" amount="45" />
                </outputs>
            </production>
            <production id="wood" name="$l10n_fillType_wood_woodchips" cyclesPerHour="60" costsPerActiveHour="1"><!-- 1,440,000 per day -->
                <inputs>
                    <input fillType="WOOD" amount="1000" />
                </inputs>
                <outputs>
                    <output fillType="WOODCHIPS" amount="1000" />
                </outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" supportsExtension="false" allowMissions="false" storageRadius="0">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="WOODCHIPS"/>

            <unloadTrigger exactFillRootNode="exactFillRootNodeLiquid" fillTypes="DIESEL WATER" aiNode="unloadTriggerAINodeLiquid"/>
            <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="10000" fillTypes="WOOD WOODCHIPS" aiNode="unloadTriggerAINodeBale" />

            <woodTrigger fillTypes="WOOD" triggerNode="woodTrigger" autoUnload="false" activationTriggerNode="woodActivationTrigger"/>
			<!-- <woodTrigger fillTypes="WOOD" triggerNode="woodTriggerContainer" autoUnload="false" activationTriggerNode="woodActivationTrigger"/> -->
            <palletTrigger triggerNode="palletTrigger" fillTypes="WOODCHIPS EMPTYPALLET WOOD"/>
			
			<!-- <palletTrigger fillTypes="WOOD" triggerNode="woodTriggerContainer"/> -->
			<!-- <unloadTrigger exactFillRootNode="unloadWoodTrigger" aiNode="unloadWoodTriggerAINode" fillTypes="WOOD"/> -->
        </sellingStation>
		
		

        <loadingStation node="loadingStation" supportsExtension="false">
            <loadTrigger triggerNode="loadingTrigger" fillLitersPerSecond="5000" dischargeNode="dischargeNode" fillTypes="WOODCHIPS">
                <effectNode effectClass="PipeEffect" effectNode="pipeEffect"      materialType="pipe"           fadeTime="0.5" maxBending="0" shapeScaleSpread="1 1 1 0" controlPoint="7.25 0 0 0"/>
                <effectNode                          effectNode="pipeEffectSmoke" materialType="unloadingSmoke" fadeTime="0.5" />
            </loadTrigger>
        </loadingStation>

