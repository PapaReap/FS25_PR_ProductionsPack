<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_theLittleMarket</name>
        <functions>
            <function>$l10n_function_theLittleMarket</function>
        </functions>
        <image>store/store_theLittleMarket.dds</image>
        <price>1300</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>491008</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>116480</indexBufferMemoryUsage>
        <textureMemoryUsage>16318464</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/theLittleMarket.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="medImp" pitchScale="1.6"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01"/>
        </levelAreas>

        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="gravel"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>
    
    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>
    
    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="woodActivationTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconExclamationMark.i3d" />
    </triggerMarkers>
    
    <sellingStation appearsOnStats="true" litersForFullPriceDrop="5000000" fullPriceRecoverHours="24" supportsExtension="false">
        <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypeCategories="BULK LIQUID PIECE SPRAYER SPREADER PRODUCT_BGA PRODUCT SLURRYTANK" fillTypesExclude="ROADSALT SNOW" fillTypes="SEEDS MILK BUFFALOMILK GOATMILK" priceScale="1.2" />

        <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypeCategories="SELLINGSTATION_PRODUCTS SELLINGSTATION_PRODUCTSFOOD SELLINGSTATION_FIELDFRUITS PIECE SHOVEL SPRAYER" fillTypesExclude="ROADSALT SNOW" fillTypes="MILK BUFFALOMILK RICECAKES WHOLEWHEATFLOUR CORN_FLOUR WHOLEWHEATBREAD CORNTORTILLA MDFBOARDS OSBBOARDS FIRELOGS WOODMULCHNATURAL WOODMULCHDARKBROWN WOODMULCHRED DARKCHOCOLATE CHOCOLATEMILKCOW CHOCOLATEMILKGOAT CHOCOLATEMILKBUFFALO SILAGE_ADDITIVE GOATMILK SEEDS CRAWFISH_BROODSTOCK" priceScale="1.2"/>

        <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="10000" fillTypeCategories="SELLINGSTATION_BALES" priceScale="1.2" />

        <woodTrigger fillTypes="WOOD" triggerNode="woodTrigger" activationTriggerNode="woodActivationTrigger" priceScale="1.2"/>
        
        <sounds>
            <idle template="farmersMarketIndoor" />
        </sounds>
        
    </sellingStation>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="sellingStation" node="0>11" />
        <i3dMapping id="exactFillRootNode" node="0>11|0" />
        <i3dMapping id="palletTrigger" node="0>11|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>11|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>11|3" />
        <i3dMapping id="baleTrigger" node="0>11|4" />
        <i3dMapping id="woodTrigger" node="0>11|5" />
        <i3dMapping id="woodActivationTrigger" node="0>11|6" />
        <i3dMapping id="woodActivationTriggerMarker" node="0>11|6|0" />
    </i3dMappings>
</placeable>
