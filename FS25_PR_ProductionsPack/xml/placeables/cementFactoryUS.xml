    <productionPoint>
        <productions>
            <!-- Cement Factory -->
            <production id="cementBags" name="$l10n_fillType_cementBags" cyclesPerHour="5" costsPerActiveHour="1">
                <inputs>
                    <input fillType="LIME" amount="1000" />
                    <input fillType="STONE" amount="250" />
                    <input fillType="EMPTYPALLET" amount="500" />
                </inputs>
                <outputs>
                    <output fillType="CEMENT" amount="500" />
                </outputs>
            </production>
            <production id="roofPlate" name="$l10n_fillType_roofPlate" cyclesPerHour="3" costsPerActiveHour="5">
                <inputs>
                    <input fillType="STONE" amount="1000" />
                    <input fillType="CEMENT" amount="300" />
                    <input fillType="STRAW" amount="100" />
                    <input fillType="WATER" amount="100" />
                    <input fillType="EMPTYPALLET" amount="250" />
                </inputs>
                <outputs>
                    <output fillType="ROOFPLATES" amount="250" />
                </outputs>
            </production>
            <production id="cementBrick" name="$l10n_fillType_cementBrick" cyclesPerHour="3" costsPerActiveHour="2">
                <inputs>
                    <input fillType="STONE" amount="1000" />
                    <input fillType="CEMENT" amount="200" />
                    <input fillType="STRAW" amount="50" />
                    <input fillType="WATER" amount="100" />
                    <input fillType="EMPTYPALLET" amount="250" />
                </inputs>
                <outputs>
                    <output fillType="CEMENTBRICKS" amount="250" />
                </outputs>
            </production>

            <production id="lime" name="%s" params="$l10n_fillType_lime" cyclesPerHour="10" costsPerActiveHour="0.2">
                <inputs>
                    <input fillType="STONE" amount="1500" />
                    <input fillType="WATER" amount="200" />
                </inputs>
                <outputs>
                    <output fillType="LIME" amount="1000" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="STONE"        capacity="240000" />
            <capacity fillType="CEMENT"       capacity="43000" />
            <capacity fillType="ROOFPLATES"   capacity="43000" />
            <capacity fillType="CEMENTBRICKS" capacity="43000" />
            <capacity fillType="LIME"         capacity="120000" />
            <capacity fillType="WATER"        capacity="60000" />
            <capacity fillType="STRAW"        capacity="20000" />
            <capacity fillType="EMPTYPALLET"    capacity="100000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="unloadTrigger" aiNode="unloadTriggerAINode" fillTypes="STONE" />
            <unloadTrigger exactFillRootNode="unloadTrigger_ls" aiNode="unloadTriggerAINode_ls" fillTypes="LIME WATER STRAW" />
            <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="2000" fillTypes="STRAW" aiNode="unloadTriggerAINode" />
            <palletTrigger triggerNode="palletTrigger" fillTypes="CEMENT LIME ROOFPLATES CEMENTBRICKS EMPTYPALLET"/>
        </sellingStation>

        <loadingStation node="loadingTrigger" supportsExtension="true" storageRadius="50">
            <loadTrigger triggerNode="loadingTriggerSolid_ls" fillLitersPerSecond="1000" dischargeNode="dischargeNodeSolid_ls" fillTypes="LIME" aiNode="aiNodeLoadingSolid_ls" >
                <effectNode effectClass="PipeEffect" effectNode="pipeEffect_ls"      materialType="pipe"           fadeTime="0.5" maxBending="0" controlPoint="4.8 0 0 0"/>
                <effectNode                          effectNode="pipeEffectSmoke_ls" materialType="unloadingSmoke" fadeTime="0.5" />
                <sounds>
                    <loading template="silosActive" />
                </sounds>
            </loadTrigger>
        </loadingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" fillTypes="CEMENT"/>
                <spawnPlace startNode="palletAreaStart03" endNode="palletAreaEnd03" fillTypes="CEMENTBRICKS"/>
                <spawnPlace startNode="palletAreaStart04" endNode="palletAreaEnd04" fillTypes="ROOFPLATES"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
    </productionPoint>

