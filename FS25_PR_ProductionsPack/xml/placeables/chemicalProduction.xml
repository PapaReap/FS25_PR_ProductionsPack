<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
            $l10n_storeItem_chemicalProduction
        </name>
        <functions>
            <function>$l10n_function_chemicalProduction</function>
        </functions>
        <image>store/store_chemicalProduction.dds</image>
        <price>125000</price>
        <dailyUpkeep>100</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>358656</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>95488</indexBufferMemoryUsage>
        <textureMemoryUsage>5242880</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/chemicalProduction.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
        <hotspot type="UNLOADING" linkNode="mapPosition" teleportNode="teleportNode"/>
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="loadingMarkerSolid" adjustToGround="true" filename="$data/shared/assets/marker/markerIconLoad.i3d" />
        <triggerMarker node="loadingMarkerFluid" adjustToGround="true" filename="$data/shared/assets/marker/markerIconLoad.i3d" />
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d" />
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <!-- HERBICIDE -->
            <production id="herbicide" name="%s" params="$l10n_fillType_herbicide" cyclesPerHour="2" costsPerActiveHour="4">
                <inputs>
                    <input fillType="FERTILIZER"    amount="325" />
                    <input fillType="LIME"          amount="150" />
                    <input fillType="LIQUIDMANURE"  amount="325" />
                    <input fillType="MANURE"        amount="325" />
                    <input fillType="DIGESTATE"     amount="325" />
                    <input fillType="WATER"         amount="500" />
                    <input fillType="EMPTYPALLET"   amount="1500" />
                </inputs>
                <outputs>
                    <output fillType="HERBICIDE" amount="1500"/>
                </outputs>
            </production>

            <!-- HERBICIDEPURE -->
            <production id="herbicidePure" name="%s" params="$l10n_fillType_herbicidePure" cyclesPerHour="2" costsPerActiveHour="4">
                <inputs>
                    <input fillType="FERTILIZER"    amount="325" />
                    <input fillType="LIME"          amount="150" />
                    <input fillType="LIQUIDMANURE"  amount="325" />
                    <input fillType="MANURE"        amount="325" />
                    <input fillType="DIGESTATE"     amount="325" />
                    <input fillType="WATER"         amount="50" />
                    <input fillType="EMPTYPALLET"   amount="38" />
                </inputs>
                <outputs>
                    <output fillType="HERBICIDEPURE" amount="38"/>
                </outputs>
            </production>

            <!-- SOLUBLEFERTILIZER -->
            <production id="solubleFertilizer" name="$l10n_fillType_solubleFertilizer" cyclesPerHour="5" costsPerActiveHour="2">
                <inputs>
                    <input fillType="MANURE"        amount="100" />
                    <input fillType="LIQUIDMANURE"  amount="50" />
                    <input fillType="DIGESTATE"     amount="100" />
                    <input fillType="LIME"          amount="80" />
                    <input fillType="STRAW"         amount="50" />
                    <input fillType="EMPTYPALLET"   amount="7" />
                </inputs>
                <outputs>
                    <output fillType="SOLUBLEFERTILIZER" amount="7" />
                </outputs>
            </production>

            <!-- SOLUBLELIME -->
            <production id="solubleLime" name="$l10n_fillType_solubleLime" cyclesPerHour="10" costsPerActiveHour="2">
                <inputs>
                    <input fillType="LIME"          amount="200" />
                    <input fillType="WATER"         amount="240" />
                    <input fillType="EMPTYPALLET"   amount="20" />
                </inputs>
                <outputs>
                    <output fillType="SOLUBLELIME" amount="20" />
                </outputs>
            </production>

            <!-- LIQUID FERTILIZER -->
            <production id="liquidFertilizer" name="%s" params="$l10n_fillType_liquidFertilizer" cyclesPerHour="4" costsPerActiveHour="3">
                <inputs>
                    <input fillType="MANURE"        amount="200" />
                    <input fillType="LIQUIDMANURE"  amount="450" />
                    <input fillType="DIGESTATE"     amount="150" />
                    <input fillType="LIME"          amount="200" />
                    <input fillType="WATER"         amount="1000" />
                </inputs>
                <outputs>
                    <output fillType="LIQUIDFERTILIZER" amount="1000" />
                </outputs>
            </production>

            <!-- LIQUID LIME -->
            <production id="lime_water_liquidlime" name="Liquid Lime" cyclesPerHour="12" costsPerActiveHour="52">
                <inputs>
                    <input fillType="LIME" amount="80" />
                    <input fillType="WATER" amount="240" />
                </inputs>
                <outputs>
                    <output fillType="LIQUIDLIME" amount="300" />
                </outputs>
            </production>

            <!-- MINERAL FEED -->
            <production id="mineral_feed" name="$l10n_fillType_mineralFeed" cyclesPerHour="4" costsPerActiveHour="2">
                <inputs>
                    <input fillType="DRYGRASS_WINDROW" amount="100" />
                    <input fillType="POTATO"         amount="50" />
                    <input fillType="SILAGE"         amount="100" />
                    <input fillType="CANOLA"         amount="100" />
                </inputs>
                <outputs>
                    <output fillType="MINERAL_FEED" amount="300" />
                </outputs>
            </production>

            <!-- SEEDS -->
            <!-- <production id="seeds" name="$l10n_fillType_seeds" cyclesPerHour="6" costsPerActiveHour="4"> -->
            <production id="seeds" name="Seeds (Barley Oat Wheat + Dried)" cyclesPerHour="6" costsPerActiveHour="4">
                <inputs>
                    <input fillType="FERTILIZER"      amount="50" />
                    <input fillType="BARLEY"          amount="100" />
                    <input fillType="WATER"           amount="50" />
                </inputs>
                <outputs>
                    <output fillType="SEEDS" amount="150" />
                </outputs>
            </production>

            <!-- SILAGE_ADDITIVE -->
            <production id="silage_additive" name="$l10n_fillType_silageAdditivePR" cyclesPerHour="2" costsPerActiveHour="2">
                <inputs>
                    <input fillType="FERTILIZER"    amount="25" />
                    <input fillType="LIME"          amount="40" />
                    <input fillType="WATER"         amount="25" />
                    <input fillType="EMPTYPALLET"   amount="60" />
                </inputs>
                <outputs>
                    <output fillType="SILAGE_ADDITIVE" amount="60" />
                </outputs>
            </production>

            <!-- SOLID FERTILIZER -->
            <production id="fertilizer" name="$l10n_fillType_fertilizer" cyclesPerHour="5" costsPerActiveHour="2">
                <inputs>
                    <input fillType="MANURE"        amount="100" />
                    <input fillType="LIQUIDMANURE"  amount="50" />
                    <input fillType="DIGESTATE"     amount="100" />
                    <input fillType="LIME"          amount="80" />
                    <input fillType="STRAW"         amount="50" />
                </inputs>
                <outputs>
                    <output fillType="FERTILIZER" amount="250" />
                </outputs>
            </production>

            <production id="yeast" name="%s" params="$l10n_fillType_yeast" cyclesPerHour="1" costsPerActiveHour="10">
                <inputs>
                    <input fillType="WATER"       amount="900" />
                    <input fillType="MOLASSES"    amount="100" />
                    <input fillType="EMPTYPALLET" amount="1200" />
                    <!-- <input fillType="CARDBOARD"   amount="100" /> -->
                </inputs>
                <outputs>
                    <output fillType="YEAST" amount="1200" />
                </outputs>
            </production>

        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="100">
            <capacity fillType="WATER"              capacity="150000" />
            <capacity fillType="POTATO"             capacity="50000" />
            <capacity fillType="SILAGE"             capacity="50000" />
            <capacity fillType="MANURE"             capacity="100000" />
            <capacity fillType="LIQUIDMANURE"       capacity="100000" />
            <capacity fillType="CANOLA"             capacity="50000" />
            <capacity fillType="DRYGRASS_WINDROW"   capacity="50000" />
            <capacity fillType="BARLEY"             capacity="50000" />
            <capacity fillType="EMPTYPALLET"        capacity="200000" />

            <capacity fillType="STRAW"              capacity="80000" />
            <capacity fillType="DIGESTATE"          capacity="80000" />
            <capacity fillType="FERTILIZER"         capacity="100000" />
            <capacity fillType="LIQUIDFERTILIZER"   capacity="100000" />
            <capacity fillType="HERBICIDE"          capacity="100000" />
            <capacity fillType="LIME"               capacity="80000" />
            <capacity fillType="SEEDS"              capacity="50000" />
            <capacity fillType="MINERAL_FEED"       capacity="50000" />
            <capacity fillType="HERBICIDEPURE"      capacity="20000" />
            <capacity fillType="SOLUBLEFERTILIZER"  capacity="20000" />
            <capacity fillType="SOLUBLELIME"        capacity="50000" />
            <capacity fillType="SILAGE_ADDITIVE"    capacity="600" />
            <capacity fillType="MOLASSES"           capacity="50000" />
            <capacity fillType="YEAST"              capacity="10000" />
            <capacity fillType="LIQUIDLIME"         capacity="80000" />
        </storage>

        <sellingStation node="sellingStation"  appearsOnStats="true" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="STRAW SEEDS FERTILIZER LIME MINERAL_FEED WATER BARLEY MANURE LIQUIDMANURE CANOLA POTATO SILAGE DRYGRASS_WINDROW DIGESTATE WHEAT OAT BARLEY_DRY WHEAT_DRY OAT_DRY LIQUIDLIME HERBICIDE LIQUIDFERTILIZER">
                <fillTypeConversion ratio="1" outgoingFillType="BARLEY" incomingFillType="WHEAT" />
                <fillTypeConversion ratio="1" outgoingFillType="BARLEY" incomingFillType="OAT" />
                <fillTypeConversion ratio="1" outgoingFillType="BARLEY" incomingFillType="BARLEY_DRY" />
                <fillTypeConversion ratio="1" outgoingFillType="BARLEY" incomingFillType="WHEAT_DRY" />
                <fillTypeConversion ratio="1" outgoingFillType="BARLEY" incomingFillType="OAT_DRY" />
            </unloadTrigger>
            <palletTrigger triggerNode="palletTrigger" fillTypes="POTATO MOLASSES HERBICIDEPURE SILAGE_ADDITIVE SOLUBLEFERTILIZER SOLUBLELIME YEAST EMPTYPALLET" />
            <baleTrigger triggerNode="baleTrigger" fillTypes="SILAGE DRYGRASS_WINDROW STRAW" deleteLitersPerSecond="2000"/>
        </sellingStation>

        <loadingStation node="loadingTriggerSolid" supportsExtension="true" storageRadius="50">
            <loadTrigger triggerNode="loadingTriggerSolid" fillLitersPerSecond="1000" dischargeNode="dischargeNodeSolid" fillTypes="SEEDS FERTILIZER MINERAL_FEED STRAW LIME" aiNode="aiLoadingNodeSolid" >
                <effectNode effectClass="PipeEffect" effectNode="pipeEffectSolid"      materialType="pipe"           fadeTime="0.5" maxBending="0" controlPoint="4.8 0 0 0"/>
                <effectNode                          effectNode="pipeEffectSmokeSolid" materialType="unloadingSmoke" fadeTime="0.5" />
                <sounds>
                    <loading template="silosActive" />
                </sounds>
            </loadTrigger>

            <loadTrigger triggerNode="loadingTriggerFluid" fillTypes="HERBICIDE LIQUIDFERTILIZER" fillLitersPerSecond="2000" dischargeNode="dischargeNodeFluid" aiNode="aiNodeLoadingFluid">
            </loadTrigger>
        </loadingStation>

        <palletSpawner>
            <pallets>
                <pallet filename="xml/pallets/yeastPallet.xml"/>
            </pallets>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" fillTypes="HERBICIDEPURE SOLUBLEFERTILIZER SILAGE_ADDITIVE YEAST LIQUIDLIME SOLUBLELIME"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle   template="placeableSmallIdleGeneric" linkNode="0>"/>
            <active template="grainMillWork" linkNode="0>" pitchScale="1.2" innerRadius="2" outerRadius="15" volumeScale="0.6"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />

        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />

        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />

        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />

        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />

        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />

        <i3dMapping id="infoTrigger" node="0>6" />

        <i3dMapping id="sellingStation" node="0>7" />
        <i3dMapping id="exactFillNode" node="0>7|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>7|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>7|2" />
        <i3dMapping id="baleTrigger" node="0>7|3" />
        <i3dMapping id="palletTrigger" node="0>7|4" />

        <i3dMapping id="playerTrigger" node="0>8|0" />
        <i3dMapping id="playerTriggerMarker" node="0>8|1" />

        <i3dMapping id="markerLoadingSolid" node="0>9|6|1" />

        <i3dMapping id="loadingStation" node="0>10" />
        <i3dMapping id="iconLoadSolid" node="0>10|0" />
        <i3dMapping id="aiLoadingNodeSolid" node="0>10|0" />
        <i3dMapping id="dischargeNodeSolid" node="0>10|1" />
        <i3dMapping id="loadingMarkerSolid" node="0>10|2" />
        <i3dMapping id="loadingTriggerSolid" node="0>10|3" />
        <i3dMapping id="dischargeEffectSolid" node="0>10|4" />
        <i3dMapping id="pipeEffectSolid" node="0>10|4|0" />
        <i3dMapping id="pipeEffectSmokeSolid" node="0>10|4|1" />
        <i3dMapping id="splineSolid" node="0>10|5" />
        <i3dMapping id="iconLoadfluid" node="0>10|7" />
        <i3dMapping id="aiNodeLoadingFluid" node="0>10|6" />
        <i3dMapping id="dischargeNodeFluid" node="0>10|7" />
        <i3dMapping id="loadingMarkerFluid" node="0>10|8" />
        <i3dMapping id="loadingTriggerFluid" node="0>10|9" />
        <i3dMapping id="splineFluid" node="0>10|10" />

        <i3dMapping id="mapPosition" node="0>11" />

        <i3dMapping id="teleportNode" node="0>12" />

        <i3dMapping id="palletAreaStart01" node="0>13|0" />
        <i3dMapping id="palletAreaEnd01" node="0>13|0|0" />

        <i3dMapping id="warningStripes01" node="0>14|0" />
        <i3dMapping id="" node="" />
        <i3dMapping id="" node="" />
        <i3dMapping id="" node="" />
        <i3dMapping id="" node="" />

    </i3dMappings>
</placeable>
