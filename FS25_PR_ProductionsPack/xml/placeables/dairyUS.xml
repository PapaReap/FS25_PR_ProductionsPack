<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_enhancedDairyUS</name>
        <functions>
            <function>$l10n_function_enhancedDairy</function>
        </functions>
        <image>store/store_dairyUS.png</image>
        <price>70000</price>
        <dailyUpkeep>110</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>673024</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>113664</indexBufferMemoryUsage>
        <textureMemoryUsage>11468800</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

    </storeData>

    <base>
        <filename>i3d/placeables/dairyUS/dairyUS.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
            <testArea startNode="testArea2Start" endNode="testArea2End" />
            <testArea startNode="testArea3Start" endNode="testArea3End" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
        <clearArea startNode="clearArea2Start" widthNode="clearArea2Width" heightNode="clearArea2Height"/>
        <clearArea startNode="clearArea3Start" widthNode="clearArea3Width" heightNode="clearArea3Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="asphalt"/>
            <levelArea startNode="levelArea2Start" widthNode="levelArea2Width" heightNode="levelArea2Height" groundType="asphalt"/>
            <levelArea startNode="levelArea3Start" widthNode="levelArea3Width" heightNode="levelArea3Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height" />
        <indoorArea startNode="indoorArea2Start" widthNode="indoorArea2Width" heightNode="indoorArea2Height" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="i3d/placeables/dairyUS/props.i3d" node="0" linkNode="propsLinkNode" />
    </dynamicallyLoadedParts>

    <lights>
        <group weatherRequiredFlags="NIGHT" />

        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml"          linkNode="linkedLight1" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml"          linkNode="linkedLight2" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml"          linkNode="linkedLight3" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialWallLight.xml" linkNode="linkedLight4" groupIndex="1"/>

        <lightShape node="interiorSelfIllum" groupIndex="1"/>
        <lightShape node="interiorDay" groupIndex="1"/>
        <lightShape node="interiorSelfIllumLOD" groupIndex="1"/>
        <lightShape node="interiorDayLOD" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <productionPoint>
        <productions> <!-- add chocolate milk, buttermilk -->
            <production id="butter_milk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_milk" cyclesPerHour="16" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="120" />
                    <input fillType="EMPTYPALLET" amount="104" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="104" /> <!-- 39,936 per day -->
                </outputs>
            </production>

            <production id="butter_goatMilk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_goatMilk" cyclesPerHour="16" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="24" />
                    <input fillType="EMPTYPALLET" amount="80" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="80" /> <!-- 30,720 per day -->
                </outputs>
            </production>

            <production id="butter_buffaloMilk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_buffaloMilk" cyclesPerHour="6" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="6" />
                    <input fillType="EMPTYPALLET" amount="90" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="90" /> <!-- 12,960 per day -->
                </outputs>
            </production>

            <production id="cheese" name="$l10n_fillType_cheese" cyclesPerHour="14" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="72" />
                    <input fillType="EMPTYPALLET" amount="70" />
                </inputs>
                <outputs>
                    <output fillType="CHEESE" amount="70" /> <!-- 23,520 per day -->
                </outputs>
            </production>

            <production id="goatcheese" name="$l10n_fillType_goatCheese" cyclesPerHour="20" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="24" />
                    <input fillType="EMPTYPALLET" amount="48" />
                </inputs>
                <outputs>
                    <output fillType="GOATCHEESE" amount="48" /> <!-- 23,040 per day -->
                </outputs>
            </production>

            <production id="buffalomozzarella" name="$l10n_fillType_buffaloMozzarella" cyclesPerHour="5" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="50" />
                    <input fillType="EMPTYPALLET" amount="42" />
                </inputs>
                <outputs>
                    <output fillType="BUFFALOMOZZARELLA" amount="42" /> <!-- 5,040 per day -->
                </outputs>
            </production>

            <production id="chocolate" name="$l10n_fillType_chocolate" cyclesPerHour="5" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK"  amount="180" />
                    <input fillType="SUGAR" amount="180" />
                    <input fillType="EMPTYPALLET" amount="180" />
                </inputs>
                <outputs>
                    <output fillType="CHOCOLATE" amount="180" /> <!-- 21,600 per day -->
                </outputs>
            </production>

            <production id="milkBottled" name="$l10n_fillType_milk_bottled" cyclesPerHour="20" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="40" />
                    <input fillType="EMPTYPALLET" amount="80" />
                </inputs>
                <outputs>
                    <output fillType="MILK_BOTTLED" amount="80" /> <!-- 38,400 per day -->
                </outputs>
            </production>

            <production id="goatmilkBottled" name="$l10n_fillType_goatMilk_bottled" cyclesPerHour="12" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="30" />
                    <input fillType="EMPTYPALLET" amount="60" />
                </inputs>
                <outputs>
                    <output fillType="GOATMILK_BOTTLED" amount="60" /> <!-- 17,280 per day -->
                </outputs>
            </production>

            <production id="buffalomilkBottled" name="$l10n_fillType_buffaloMilk_bottled" cyclesPerHour="12" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="30" />
                    <input fillType="EMPTYPALLET" amount="60" />
                </inputs>
                <outputs>
                    <output fillType="BUFFALOMILK_BOTTLED" amount="60" /> <!-- 17,280 per day -->
                </outputs>
            </production>

            <!-- new productions -->
            <production id="butter_garlic" name="%s" params="$l10n_fillType_garlicButter" cyclesPerHour="10" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="120" />
                    <input fillType="GARLIC" amount="24" />
                    <input fillType="EMPTYPALLET" amount="120" />
                </inputs>
                <outputs>
                    <output fillType="GARLICBUTTER" amount="120" /> <!-- 28,800 per day -->
                </outputs>
            </production>

            <production id="yoghurt" name="$l10n_fillType_yoghurt" cyclesPerHour="10" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="160" />
                    <input fillType="SUGAR" amount="32" />
                    <input fillType="EMPTYPALLET" amount="160" />
                </inputs>
                <outputs>
                    <output fillType="YOGHURT" amount="160" /> <!-- 38,400 per day -->
                </outputs>
            </production>

            <production id="strawberryMilk" name="$l10n_fillType_strawberryMilk_bottled" cyclesPerHour="6" costsPerActiveHour="8">
                <inputs>
                    <input fillType="MILK" amount="180" />
                    <input fillType="STRAWBERRY" amount="40" />
                    <input fillType="SUGAR" amount="40" />
                    <input fillType="EMPTYPALLET" amount="220" />
                </inputs>
                <outputs>
                    <output fillType="STRAWBERRYMILK_BOTTLED" amount="220" /> <!-- 31,680 per day -->
                </outputs>
            </production>

        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="MILK"                capacity="72000" />
            <capacity fillType="STRAWBERRY"          capacity="72000" />
            <capacity fillType="GARLIC"              capacity="72000" />
            <capacity fillType="STRAWBERRYMILK_BOTTLED" capacity="72000" />
            <capacity fillType="YOGHURT"             capacity="72000" />
            <capacity fillType="GOATMILK"            capacity="29000" />
            <capacity fillType="BUFFALOMILK"         capacity="15000" />
            <capacity fillType="SUGAR"               capacity="26000" />
            <capacity fillType="BUTTER"              capacity="70000" />
            <capacity fillType="CHEESE"              capacity="40000" />
            <capacity fillType="GOATCHEESE"          capacity="40000" />
            <capacity fillType="BUFFALOMOZZARELLA"   capacity="10000" />
            <capacity fillType="CHOCOLATE"           capacity="30000" />
            <capacity fillType="MILK_BOTTLED"        capacity="96000" />
            <capacity fillType="GOATMILK_BOTTLED"    capacity="30000" />
            <capacity fillType="BUFFALOMILK_BOTTLED" capacity="30000" />
            <capacity fillType="GARLICBUTTER"        capacity="30000" />
            <capacity fillType="EMPTYPALLET"         capacity="200000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="MILK GOATMILK BUFFALOMILK"/>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="MILK GOATMILK BUFFALOMILK SUGAR STRAWBERRY GARLIC EMPTYPALLET"/>
        </sellingStation>

        <palletSpawner node="palletSpawner">
            <spawnPlaces>
                <spawnPlace startNode="spawnSpace1start" />
                <spawnPlace startNode="spawnSpace2start" />
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <!-- <idle   template="dairyIdle" linkNode="0>" /> -->
            <idle />
            <active template="dairyWork" linkNode="0>" volumeScale="0.3" />
        </sounds>

        <animationNodes>
            <animationNode  node="branding_milkCarton" rotSpeed="10" rotAxis="2" />
        </animationNodes>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes" />
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="branding_milkCarton" node="0>0|0|0|1|5" />
        <i3dMapping id="interiorSelfIllum" node="0>0|0|0|2|0|0" />
        <i3dMapping id="interiorDay" node="0>0|0|0|2|0|1" />
        <i3dMapping id="propsLinkNode" node="0>0|0|0|3" />
        <i3dMapping id="interiorDayLOD" node="0>0|1|0|4" />
        <i3dMapping id="interiorSelfIllumLOD" node="0>0|1|0|5" />
        <i3dMapping id="clearArea1Start" node="0>1|0" />
        <i3dMapping id="clearArea1Width" node="0>1|0|0" />
        <i3dMapping id="clearArea1Height" node="0>1|0|1" />
        <i3dMapping id="clearArea2Start" node="0>1|1" />
        <i3dMapping id="clearArea2Width" node="0>1|1|0" />
        <i3dMapping id="clearArea2Height" node="0>1|1|1" />
        <i3dMapping id="clearArea3Start" node="0>1|2" />
        <i3dMapping id="clearArea3Width" node="0>1|2|0" />
        <i3dMapping id="clearArea3Height" node="0>1|2|1" />
        <i3dMapping id="levelArea1Start" node="0>2|0" />
        <i3dMapping id="levelArea1Width" node="0>2|0|0" />
        <i3dMapping id="levelArea1Height" node="0>2|0|1" />
        <i3dMapping id="levelArea2Start" node="0>2|1" />
        <i3dMapping id="levelArea2Width" node="0>2|1|0" />
        <i3dMapping id="levelArea2Height" node="0>2|1|1" />
        <i3dMapping id="levelArea3Start" node="0>2|2" />
        <i3dMapping id="levelArea3Width" node="0>2|2|0" />
        <i3dMapping id="levelArea3Height" node="0>2|2|1" />
        <i3dMapping id="indoorArea1Start" node="0>3|0" />
        <i3dMapping id="indoorArea1Width" node="0>3|0|0" />
        <i3dMapping id="indoorArea1Height" node="0>3|0|1" />
        <i3dMapping id="indoorArea2Start" node="0>3|1" />
        <i3dMapping id="indoorArea2Width" node="0>3|1|0" />
        <i3dMapping id="indoorArea2Height" node="0>3|1|1" />
        <i3dMapping id="testArea1Start" node="0>4|0" />
        <i3dMapping id="testArea1End" node="0>4|0|0" />
        <i3dMapping id="testArea2Start" node="0>4|1" />
        <i3dMapping id="testArea2End" node="0>4|1|0" />
        <i3dMapping id="testArea3Start" node="0>4|2" />
        <i3dMapping id="testArea3End" node="0>4|2|0" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>5|0|0" />
        <i3dMapping id="infoTrigger" node="0>6" />
        <i3dMapping id="realLightsLow" node="0>9|0|0" />
        <i3dMapping id="realLightsHigh" node="0>9|0|1" />
        <i3dMapping id="linkedLight1" node="0>9|1|0" />
        <i3dMapping id="linkedLight2" node="0>9|1|1" />
        <i3dMapping id="linkedLight3" node="0>9|1|2" />
        <i3dMapping id="linkedLight4" node="0>9|1|3" />

        <i3dMapping id="sellingStation" node="0>10" />
        <i3dMapping id="exactFillRootNode" node="0>10|0" />
        <i3dMapping id="palletTrigger" node="0>10|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>10|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>10|3" />

        <i3dMapping id="playerTrigger" node="0>11|0" />
        <i3dMapping id="playerTriggerMarker" node="0>11|1" />

        <i3dMapping id="palletSpawner" node="0>12" />
        <i3dMapping id="spawnSpace1start" node="0>12|0" />
        <i3dMapping id="spawnSpace2start" node="0>12|1" />

        <i3dMapping id="warningStripes" node="0>13" />
    </i3dMappings>
</placeable>
