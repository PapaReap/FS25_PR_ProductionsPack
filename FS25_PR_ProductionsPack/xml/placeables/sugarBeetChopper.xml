<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_sugarBeetChopper</name>
        <image>store/store_sugarBeetChopper.dds</image>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <price>75000</price>
        <dailyUpkeep>21</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <storeIconRendering>
            <settings cameraXRot="-20" cameraYRot="130" advancedBoundingBox="true"/>
        </storeIconRendering>
        <vertexBufferMemoryUsage>710912</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>152064</indexBufferMemoryUsage>
        <textureMemoryUsage>16973824</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/sugarBeetChopper.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <buysFarmland priceScale="1">false</buysFarmland>
        <canBeDeleted>true</canBeDeleted>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea01Start" widthNode="clearArea01Width" heightNode="clearArea01Height" />
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelingArea01Start" widthNode="levelingArea01Width" heightNode="levelingArea01Height" groundType="concrete" />
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="mapPosition" teleportNode="mapPosition" />
    </hotspots>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/terraLed/spotlight20W.xml" linkNode="linkedLight01" groupIndex="1">
            <rotationNode name="rotationNode01" rotation="55 0 0" />
        </sharedLight>
        <sharedLight filename="$data/shared/assets/lights/terraLed/spotlight20W.xml" linkNode="linkedLight02" groupIndex="1">
            <rotationNode name="rotationNode01" rotation="55 0 0" />
        </sharedLight>
        <sharedLight filename="$data/shared/assets/lights/terraLed/spotlight20W.xml" linkNode="linkedLight03" groupIndex="1">
            <rotationNode name="rotationNode01" rotation="55 0 0" />
        </sharedLight>
        <sharedLight filename="$data/shared/assets/lights/terraLed/spotlight20W.xml" linkNode="linkedLight04" groupIndex="1">
            <rotationNode name="rotationNode01" rotation="55 0 0" />
        </sharedLight>
        <realLights>
            <low>
                <!--light node="realLightsLow" groupIndex="1"/-->
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1" />
            </high>
        </realLights>
        <group name="$l10n_action_placeableLightShed" activateTime="17:30" deactivateTime="8:20" />
    </lights>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="powerSwitch01" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
        <dynamicallyLoadedPart node="0" linkNode="powerSwitch02" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
        <dynamicallyLoadedPart node="0" linkNode="powerSwitch03" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
        <dynamicallyLoadedPart node="0" linkNode="lightSwitch01" filename="$data/shared/assets/lights/terraLed/switch.i3d" />
    </dynamicallyLoadedParts>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="sugarbeet_cut" name="%s (%s %s)" params="$l10n_fillType_sugarBeetCut|$l10n_fillType_stone|$l10n_fillType_digestate" cyclesPerHour="72" costsPerActiveHour="20">
                <inputs>
                    <input fillType="SUGARBEET" amount="300" />
                    <input fillType="WATER" amount="45" />
                </inputs>
                <outputs>
                    <output fillType="SUGARBEET_CUT" amount="285" />
                    <!--           <output fillType="COMPOST" amount="22.5" /> -->
                    <output fillType="DIGESTATE" amount="45" />
                    <output fillType="STONE" amount="35" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="SUGARBEET" capacity="200000" />
            <capacity fillType="WATER" capacity="40000" />
            <capacity fillType="SUGARBEET_CUT" capacity="100000" />
            <!--       <capacity fillType="COMPOST" capacity="15000" /> -->
            <capacity fillType="DIGESTATE" capacity="20000" />
            <capacity fillType="STONE" capacity="15000" />

            <fillPlane fillType="SUGARBEET" node="beetsPlane" minY="0" maxY="1.56"/>
            <fillPlane fillType="SUGARBEET_CUT" node="beetsCutPlane" minY="0" maxY="3.35"/>
            <!--       <fillPlane fillType="COMPOST" node="compostPlane" minY="0" maxY="3.35"/> -->
            <fillPlane fillType="STONE" node="stonePlane" minY="0" maxY="3.35"/>
        </storage>

        <loadingStation node="loadingStation" supportsExtension="false">
            <loadTrigger triggerNode="loadingStation01" fillTypes="SUGARBEET_CUT STONE" fillLitersPerSecond="1000" dischargeNode="dischargeNode01" aiSpline="aiSpline01">
                <effectNode effectNode="pipeEffect01" effectClass="PipeEffect" materialType="pipe" fadeTime="0.5" maxBending="0" shapeScaleSpread="0.8 0.8 1 0" controlPoint="5 0 0 0" />
                <effectNode effectNode="pipeEffectSmoke01" materialType="unloadingSmoke" fadeTime="0.5" />
            </loadTrigger>
            <loadTrigger triggerNode="loadingStation02" fillTypes="DIGESTATE" fillLitersPerSecond="600" dischargeNode="dischargeNode02" aiSpline="aiSpline02"/>
        </loadingStation>

        <sellingStation node="sellingStation" supportsExtension="false" appearsOnStats="true" hideFromPricesMenu="true" >
            <unloadTrigger exactFillRootNode="exactFillRootNode01" fillTypes="SUGARBEET" />
            <unloadTrigger exactFillRootNode="exactFillRootNode02" fillTypes="WATER" />
        </sellingStation>

        <animationNodes>
            <animationNode node="beetsBand" type="productionPoint" class="ScrollingAnimation" shaderParameterName="offsetUV" shaderParameterComponent="2" scrollLength="10" scrollSpeed="0.1" turnOnFadeTime="0.5" turnOffFadeTime="2" />
            <animationNode node="roller01" type="productionPoint" rotAxis="3" rotSpeed="-250" />
        </animationNodes>

        <playerTrigger node="playerTrigger" />

        <effectNodes>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEffectChimneyShape02" particleType="SMOKE_CHIMNEY" emitCountScale="0.5"/>
        </effectNodes>

        <sounds>
            <idle   template="biogasPlantTemplate" linkNode="0>" outerRadius="50"/>
            <active template="dairyWork" linkNode="0>" outerRadius="50"/>
        </sounds>
    </productionPoint>

    <infoTrigger triggerNode="infoTrigger" />

    <triggerMarkers>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="loadTriggerMarker01" filename="$data/shared/assets/marker/markerIconLoad.i3d" adjustToGround="true" />
        <triggerMarker node="loadTriggerMarker02" filename="$data/shared/assets/marker/markerIconLoad.i3d" adjustToGround="false" />
        <triggerMarker node="unloadTriggerMarker01" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="false" />
        <triggerMarker node="unloadTriggerMarker02" filename="$data/shared/assets/marker/markerIconWater.i3d" adjustToGround="true" />
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="beetChopper" node="0>" />
        <i3dMapping id="clearArea01Start" node="0>0|0" />
        <i3dMapping id="clearArea01Height" node="0>0|0|0" />
        <i3dMapping id="clearArea01Width" node="0>0|0|1" />
        <i3dMapping id="levelingArea01Start" node="0>1|0" />
        <i3dMapping id="levelingArea01Height" node="0>1|0|0" />
        <i3dMapping id="levelingArea01Width" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>3|0|0" />
        <i3dMapping id="exactFillRootNode01" node="0>4|0" />
        <i3dMapping id="exactFillRootNode02" node="0>4|1" />
        <i3dMapping id="unloadTriggerMarker01" node="0>4|2" />
        <i3dMapping id="unloadTriggerMarker02" node="0>4|3" />
        <i3dMapping id="loadingStation01" node="0>5|0" />
        <i3dMapping id="dischargeNode01" node="0>5|0|0" />
        <i3dMapping id="pipeEffect01" node="0>5|0|0|0" />
        <i3dMapping id="pipeEffectSmoke01" node="0>5|0|0|1" />
        <i3dMapping id="loadTriggerMarker01" node="0>5|0|1" />
        <i3dMapping id="aiSpline01" node="0>5|1" />
        <i3dMapping id="loadingStation02" node="0>5|2" />
        <i3dMapping id="dischargeNode02" node="0>5|2|0" />
        <i3dMapping id="loadTriggerMarker02" node="0>5|2|1" />
        <i3dMapping id="aiSpline02" node="0>5|3" />
        <i3dMapping id="playerTrigger" node="0>6|0" />
        <i3dMapping id="playerTriggerMarker" node="0>6|0|0" />
        <i3dMapping id="infoTrigger" node="0>6|1" />
        <i3dMapping id="beetsPlane" node="0>6|2" />
        <i3dMapping id="beetsCutPlane" node="0>6|3" />
        <!--     <i3dMapping id="compostPlane" node="0>6|4" /> -->
        <i3dMapping id="stonePlane" node="0>6|5" />
        <i3dMapping id="roller01" node="0>6|6" />
        <i3dMapping id="smokeEffectChimneyShape02" node="0>6|7" />
        <i3dMapping id="beetsBand" node="0>6|8" />
        <i3dMapping id="mapPosition" node="0>6|9" />
        <i3dMapping id="lightSwitch01" node="0>7|4|1" />
        <i3dMapping id="powerSwitch01" node="0>7|4|2" />
        <i3dMapping id="powerSwitch02" node="0>7|4|3" />
        <i3dMapping id="powerSwitch03" node="0>7|4|4" />
        <i3dMapping id="linkedLight01" node="0>7|4|5|1|0" />
        <i3dMapping id="linkedLight02" node="0>7|4|5|1|1" />
        <i3dMapping id="linkedLight03" node="0>7|4|5|1|2" />
        <i3dMapping id="linkedLight04" node="0>7|4|5|1|3" />
        <i3dMapping id="realLightsHigh" node="0>7|4|5|1|4" />
    </i3dMappings>
</placeable>
