<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="PR_productionPoint_storage" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_readyMealsProcessing</name>
        <functions>
            <function>$l10n_function_readyMealsProcessing</function>
        </functions>
        <image>store/store_readyMealsProcessing.png</image>
        <price>20000</price>
        <dailyUpkeep>40</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>432896</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>64256</indexBufferMemoryUsage>
        <textureMemoryUsage>11075584</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/readyMealsProcessing.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="gravel"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <triggerMarkers>
        <triggerMarker node="warningStripesUnload" adjustToGround="true" />
        <triggerMarker node="warningStripesSpawn" adjustToGround="true" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="objectTriggerMarkerStorage" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="playerTriggerMarkerStorage" filename="$data/shared/assets/marker/markerIconPallet.i3d" adjustToGround="true" />
    </triggerMarkers>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <productionPoint>
        <productions>
            <production id="crawfishEtouffee" name="$l10n_fillType_crawfishEtouffee" cyclesPerHour="2" costsPerActiveHour="16">
                <inputs>
                    <input fillType="COOKINGOIL" amount="15" />
                    <input fillType="FLOUR" amount="20" />
                    <input fillType="SPRING_ONION" amount="28" />
                    <input fillType="CHILLI" amount="28" />
                    <input fillType="GARLIC" amount="28" />
                    <input fillType="CRAWFISH" amount="100" />
                    <input fillType="WATER" amount="100" />
                    <input fillType="RICE_DRY" amount="55" />
                    <input fillType="EMPTYPALLET" amount="250" />
                </inputs>
                <outputs>
                    <output fillType="CRAWFISHETOUFFEE" amount="250" /> <!-- 12,000 per day -->
                </outputs>
            </production>
            <production id="spaghettiMeatballs" name="$l10n_fillType_spaghettiMeatballs" cyclesPerHour="3" costsPerActiveHour="16">
                <inputs>
                    <input fillType="SPRING_ONION" amount="18" />
                    <input fillType="CHILLI" amount="18" />
                    <input fillType="GARLIC" amount="28" />
                    <input fillType="TOMATO" amount="38" /> <!-- Add tomato sauce -->
                    <input fillType="CHEESE" amount="18" />
                    <input fillType="SPAGHETTIPASTA" amount="90" />
                    <input fillType="GROUNDBEEF" amount="60" />
                    <input fillType="WATER" amount="100" />
                    <input fillType="EMPTYPALLET" amount="240" />
                </inputs>
                <outputs>
                    <output fillType="SPAGHETTIMEATBALLS" amount="240" /> <!--  per day -->
                </outputs>
            </production>
            <production id="spaghettiSausage" name="$l10n_fillType_spaghettiSausage" cyclesPerHour="3" costsPerActiveHour="16">
                <inputs>
                    <input fillType="SPRING_ONION" amount="18" />
                    <input fillType="CHILLI" amount="28" />
                    <input fillType="GARLIC" amount="28" />
                    <input fillType="TOMATO" amount="40" /> <!-- Add tomato sauce -->
                    <input fillType="CHEESE" amount="18" />
                    <input fillType="SPAGHETTIPASTA" amount="90" />
                    <input fillType="SAUSAGE" amount="50" />
                    <input fillType="WATER" amount="100" />
                    <input fillType="EMPTYPALLET" amount="230" />
                </inputs>
                <outputs>
                    <output fillType="SPAGHETTISAUSAGE" amount="230" /> <!--  per day -->
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <!-- INPUT -->
            <capacity fillType="COOKINGOIL"     capacity="10000" />
            <capacity fillType="FLOUR"          capacity="50000" />
            <capacity fillType="SPRING_ONION"   capacity="10000" />
            <capacity fillType="CHILLI"         capacity="10000" />
            <capacity fillType="GARLIC"         capacity="10000" />
            <capacity fillType="TOMATO"         capacity="10000" />
            <capacity fillType="CHEESE"         capacity="10000" />
            <capacity fillType="CRAWFISH"       capacity="20000" />
            <capacity fillType="WATER"          capacity="50000" />
            <capacity fillType="RICE_DRY"       capacity="50000" />
            <capacity fillType="SPAGHETTIPASTA" capacity="40000" />
            <capacity fillType="CRAWFISH"       capacity="20000" />
            <capacity fillType="GROUNDBEEF"     capacity="30000" />
            <capacity fillType="SAUSAGE"        capacity="30000" />
            <capacity fillType="EMPTYPALLET"    capacity="200000" />
            <!-- OUTPUT -->
            <capacity fillType="CRAWFISHETOUFFEE"   capacity="70000" />
            <capacity fillType="SPAGHETTIMEATBALLS" capacity="80000" />
            <capacity fillType="SPAGHETTISAUSAGE"   capacity="80000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="WATER RICELONGGRAIN_DRY RICE_DRY" >
                <fillTypeConversion ratio="0.77" outgoingFillType="RICE_DRY" incomingFillType="RICELONGGRAIN_DRY" />
            </unloadTrigger>

            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="COOKINGOIL FLOUR SPRING_ONION CHILLI GARLIC TOMATO CHEESE SPAGHETTIPASTA GROUNDBEEF SAUSAGE CRAWFISH RICE_DRY RICELONGGRAIN_DRY SUNFLOWER_OIL CANOLA_OIL OLIVE_OIL RICEFLOUR FLOURSACKS PEASFLOUR EMPTYPALLET" >
            <!-- CRAWFISHETOUFFEE SPAGHETTIMEATBALLS SPAGHETTISAUSAGE  -->

                <fillTypeConversion ratio="1" outgoingFillType="COOKINGOIL" incomingFillType="SUNFLOWER_OIL" />
                <fillTypeConversion ratio="1" outgoingFillType="COOKINGOIL" incomingFillType="OLIVE_OIL" />
                <fillTypeConversion ratio="1" outgoingFillType="COOKINGOIL" incomingFillType="CANOLA_OIL" />

                <fillTypeConversion ratio="1" outgoingFillType="FLOUR" incomingFillType="RICEFLOUR" />
                <fillTypeConversion ratio="1" outgoingFillType="FLOUR" incomingFillType="FLOURSACKS" />
                <fillTypeConversion ratio="1" outgoingFillType="FLOUR" incomingFillType="PEASFLOUR" />
            </palletTrigger>

        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="spawnAreaStart01Production" endNode="spawnAreaEnd01Production"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <!-- <idle   template="dairyIdle" linkNode="0>" /> -->
            <idle />
            <active template="dairyWork" linkNode="0>" />
        </sounds>
    </productionPoint>

    <objectStorage supportsBales="false" supportsPallets="true"  maxLength="2.5" maxWidth="2.5" maxHeight="1.7" capacity="116">
        <playerTrigger node="playerTriggerStorage" />
        <objectTrigger node="objectTriggerStorage" />
        <spawnAreas>
            <spawnArea startNode="spawnAreaStart01Storage" endNode="spawnAreaEnd01Storage" directionNode="spawnDirectionNode"/>
        </spawnAreas>
        <storageAreas>
            <storageArea startNode="storageAreaA1Start" endNode="storageAreaA1End"/>
            <storageArea startNode="storageAreaA2Start" endNode="storageAreaA2End"/>
            <storageArea startNode="storageAreaA3Start" endNode="storageAreaA3End"/>
            <storageArea startNode="storageAreaA4Start" endNode="storageAreaA4End"/>
            <storageArea startNode="storageAreaB1Start" endNode="storageAreaB1End"/>
            <storageArea startNode="storageAreaB2Start" endNode="storageAreaB2End"/>
            <storageArea startNode="storageAreaB3Start" endNode="storageAreaB3End"/>
            <storageArea startNode="storageAreaB4Start" endNode="storageAreaB4End"/>
            <storageArea startNode="storageAreaC1Start" endNode="storageAreaC1End"/>
            <storageArea startNode="storageAreaC2Start" endNode="storageAreaC2End"/>
            <storageArea startNode="storageAreaC3Start" endNode="storageAreaC3End"/>
            <storageArea startNode="storageAreaC4Start" endNode="storageAreaC4End"/>
