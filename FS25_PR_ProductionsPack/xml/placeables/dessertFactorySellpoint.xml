<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_dessertFactorySellpoint</name>
        <functions>
            <function>$l10n_function_dessertFactorySellpoint</function>
        </functions>
        <image>store/store_dessertFactorySellpoint.dds</image>
        <price>1000</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>placeable</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>530944</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>159488</indexBufferMemoryUsage>
        <textureMemoryUsage>6094848</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/dessertFactorySellpoint.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height" />
        <indoorArea startNode="indoorArea2Start" widthNode="indoorArea2Width" heightNode="indoorArea2Height" />
        <indoorArea startNode="indoorArea3Start" widthNode="indoorArea3Width" heightNode="indoorArea3Height" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false" allowMissions="false" litersForFullPriceDrop="200000" fullPriceRecoverHours="48">
        <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="CREME_CARAMEL STRAWBERRY_SORBET CHOCOLATE_MOUSSE CHOCOLATE_BROWNIE CHOCOLATE_FONDANT STRAWBERRY_JAM" />
        <fillType name="CREME_CARAMEL"      priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="STRAWBERRY_SORBET"  priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="CHOCOLATE_MOUSSE"   priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="CHOCOLATE_BROWNIE"  priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="CHOCOLATE_FONDANT"  priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="STRAWBERRY_JAM"     priceScale="1" supportsGreatDemand="true" disablePriceDrop="false" />
    </sellingStation>

    <triggerMarkers>
        <triggerMarker node="warningStripes_palletUnloadArea" />
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="testArea1Start" node="0>5|0" />
        <i3dMapping id="testArea1End" node="0>5|0|0" />
        <i3dMapping id="clearArea1Start" node="0>1|0" />
        <i3dMapping id="clearArea1Width" node="0>1|0|0" />
        <i3dMapping id="clearArea1Height" node="0>1|0|1" />
        <i3dMapping id="levelArea1Start" node="0>2|0" />
        <i3dMapping id="levelArea1Width" node="0>2|0|0" />
        <i3dMapping id="levelArea1Height" node="0>2|0|1" />
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>1|0" />
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>1|0|0" />
        <i3dMapping id="warningStripes_palletUnloadArea" node="0>3|0" />
        <i3dMapping id="sellingStation" node="0>4" />
        <i3dMapping id="palletTrigger" node="0>4|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>4|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>4|2" />
        <i3dMapping id="indoorArea1Start" node="0>9|0" />
        <i3dMapping id="indoorArea1Width" node="0>9|0|0" />
        <i3dMapping id="indoorArea1Height" node="0>9|0|1" />
        <i3dMapping id="indoorArea2Start" node="0>9|1" />
        <i3dMapping id="indoorArea2Width" node="0>9|1|0" />
        <i3dMapping id="indoorArea2Height" node="0>9|1|1" />
        <i3dMapping id="indoorArea3Start" node="0>9|2" />
        <i3dMapping id="indoorArea3Width" node="0>9|2|0" />
        <i3dMapping id="indoorArea3Height" node="0>9|2|1" />
    </i3dMappings>
</placeable>
