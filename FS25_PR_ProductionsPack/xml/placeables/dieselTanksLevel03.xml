<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="buyingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>
            <en> Methane Buypoint </en>
            <de> Methan-Kaufpunkt </de>
            <fr> Point d'achat de méthane </fr>
        </name>
        <image>$data/placeables/brandless/dieselTanks/level03/store_dieselTanksLevel03.png</image>
        <price>1000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <canBeSold>true</canBeSold>
        <showInStore>true</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>dieselTanks</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>containers</tab>
        </brush>
        <vertexBufferMemoryUsage>106496</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>26368</indexBufferMemoryUsage>
        <textureMemoryUsage>1638400</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/i3d/dieselTanksLevel03.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="siloImp" pitchScale="1.4"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas />

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <triggerMarkers>
        <triggerMarker node="loadingMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d" />
    </triggerMarkers>

    <buyingStation node="loadingStation" supportsExtension="false">
        <loadTrigger triggerNode="loadingTrigger" fillTypes="METHANE" fillLitersPerSecond="500" infiniteCapacity="true" aiNode="aiNodeLoading">
        </loadTrigger>
        <fillType name="METHANE" priceScale="0.25" />
    </buyingStation>

    <hotspots>
        <hotspot type="LOADING" linkNode="hotspotNode" teleportNode="loadingMarker"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="testAreaStart01" node="0>2|0" />
        <i3dMapping id="testAreaEnd01" node="0>2|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="loadingStation" node="0>4|0" />
        <i3dMapping id="loadingTrigger" node="0>4|0|0" />
        <i3dMapping id="dischargeNode" node="0>4|0|1" />
        <i3dMapping id="loadingMarker" node="0>4|0|2" />
        <i3dMapping id="aiNodeLoading" node="0>4|0|3" />
        <i3dMapping id="storage" node="0>4|1" />
        <i3dMapping id="hotspotNode" node="0>4|2" />
        <i3dMapping id="infoTrigger" node="0>4|3" />
        <i3dMapping id="dieselTanksLevel03" node="0>6|0" />
        <i3dMapping id="tipCollision" node="0>6|1" />
    </i3dMappings>
</placeable>
