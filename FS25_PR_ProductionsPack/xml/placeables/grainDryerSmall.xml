<?xml version="1.0" encoding="utf-8" standalone="no" ?>

<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
		<name>$l10n_storeItem_grainDryerSmall</name>
        <functions>
            <function>$l10n_function_grainDryerSmall</function>
        </functions>
        <image>store/store_grainDryerSmall.dds</image>
        <price>5000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>369664</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>98560</indexBufferMemoryUsage>
        <textureMemoryUsage>3407872</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

     <base>
        <filename>i3d/grainDryerSmall.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

   <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="largeImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="concrete"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="playerTrigger" teleportNode="teleportNode"/>
    </hotspots>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="WHEAT_DRY" name="$l10n_fillType_wheat_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="WHEAT" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="WHEAT_DRY" amount="1000" />
                </outputs>
            </production>
            <production id="BARLEY_DRY" name="$l10n_fillType_barley_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="BARLEY" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="BARLEY_DRY" amount="1000" />
                </outputs>
            </production>
            <production id="OAT_DRY" name="$l10n_fillType_oat_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="OAT" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="OAT_DRY" amount="1000" />
                </outputs>
            </production>
            <production id="CORN_DRY" name="$l10n_fillType_corn_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="MAIZE" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="CORN_DRY" amount="1000" />
                </outputs>
            </production>
            <!-- NEW -->
            <production id="RICELONGGRAIN_DRY" name="$l10n_fillType_riceLongGrain_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="RICELONGGRAIN" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="RICELONGGRAIN_DRY" amount="1000" />
                </outputs>
            </production>

            <production id="RICE_DRY" name="$l10n_fillType_rice_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="RICE" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="RICE_DRY" amount="1000" />
                </outputs>
            </production>

            <production id="SORGHUM_DRY" name="$l10n_fillType_sorghum_dry" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="SORGHUM" amount="1000" />
                    <input fillType="WOOD" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="SORGHUM_DRY" amount="1000" />
                </outputs>
            </production>
            <!-- NEW END -->
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WHEAT"    capacity="50000" />
            <capacity fillType="WHEAT_DRY"   capacity="50000" />
            <capacity fillType="BARLEY"    capacity="50000" />
            <capacity fillType="BARLEY_DRY"   capacity="50000" />
            <capacity fillType="OAT"    capacity="50000" />
            <capacity fillType="OAT_DRY"   capacity="50000" />
            <capacity fillType="MAIZE"    capacity="50000" />
            <capacity fillType="CORN_DRY"   capacity="50000" />
            <!-- NEW -->
            <capacity fillType="RICELONGGRAIN"    capacity="50000" />
            <capacity fillType="RICELONGGRAIN_DRY"   capacity="50000" />
            <capacity fillType="RICE"    capacity="50000" />
            <capacity fillType="RICE_DRY"   capacity="50000" />
            <capacity fillType="SORGHUM"    capacity="50000" />
            <capacity fillType="SORGHUM_DRY"   capacity="50000" />
            <!-- NEW END -->
            <capacity fillType="WOOD"    capacity="50000" />
        </storage>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false" hideFromPricesMenu="true">
            <woodTrigger fillTypes="WOOD" triggerNode="woodTrigger" autoUnload="true"/>
            <unloadTrigger exactFillRootNode="grainTrigger" fillTypes="WHEAT BARLEY OAT MAIZE RICELONGGRAIN RICE SORGHUM"/>
        </sellingStation>

       <loadingStation node="loadingTrigger">
            <loadTrigger triggerNode="loadingTrigger" fillTypes="WHEAT_DRY WHEAT BARLEY_DRY BARLEY OAT_DRY OAT CORN_DRY RICELONGGRAIN RICELONGGRAIN_DRY RICE RICE_DRY SORGHUM SORGHUM_DRY" fillLitersPerSecond="2000" dischargeNode="dischargeNode" >
            </loadTrigger>
        </loadingStation>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <active template="grainMillWork" linkNode="0>" />
        </sounds>

    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="0>0|0|1" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="0>0|0|5" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="0>1|8|1" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
        <triggerMarker node="0>1|7|1" filename="$data/shared/assets/marker/markerIconLoad.i3d"   adjustToGround="true" />

    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="sellingStation" node="0>0|0" />
        <i3dMapping id="woodTrigger" node="0>0|0|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>0|0|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>0|0|2" />
        <i3dMapping id="teleportNode" node="0>0|0|3" />
        <i3dMapping id="grainTrigger" node="0>0|0|6" />
        <i3dMapping id="unloadTriggerMarker" node="0>0|0|5" />
        <i3dMapping id="unloadTriggerAINode" node="0>0|0|4" />
        <i3dMapping id="warningStripes01" node="0>0|1|0" />
        <i3dMapping id="clearAreas" node="0>1|0" />
        <i3dMapping id="clearAreaStart01" node="0>1|0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>1|0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>1|0|0|1" />
        <i3dMapping id="levelAreas" node="0>1|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>1|2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>1|2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>1|2|0|1" />
        <i3dMapping id="indoorAreas" node="0>1|3" />
        <i3dMapping id="indoorAreaStart01" node="0>1|3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>1|3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>1|3|0|1" />
        <i3dMapping id="testAreas" node="0>1|4" />
        <i3dMapping id="testAreaStart01" node="0>1|4|0" />
        <i3dMapping id="testAreaEnd01" node="0>1|4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreas" node="0>1|5" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>1|5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>1|5|0|0" />
        <i3dMapping id="infoTrigger" node="0>1|6" />
        <i3dMapping id="loadingStation" node="0>1|7" />
        <i3dMapping id="loadingTriggers" node="0>1|7|0" />
        <i3dMapping id="loadingTrigger" node="0>1|7|0|0" />
        <i3dMapping id="dischargeNode" node="0>1|7|0|1" />
        <i3dMapping id="aiLoadingNode" node="0>1|7|0|2" />
        <i3dMapping id="markerLoading" node="0>1|7|1" />
        <i3dMapping id="productionPoint" node="0>1|8" />
        <i3dMapping id="playerTrigger" node="0>1|8|0" />
        <i3dMapping id="playerTriggerMarker" node="0>1|8|1" />
        <i3dMapping id="warningStripes01" node="0>1|9|0" />
        <i3dMapping id="warningStripes02" node="0>1|9|1" />

    </i3dMappings>
</placeable>
