<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd"> <!-- productionPoint animatedProductionPoint -->
    <storeData>
        <!-- <name>$l10n_storeItem_crawfishHatchery</name> -->
        <name><en>Crawfish Hatchery</en></name>
        <functions>
            <!-- <function>$l10n_function_crawfishHatchery</function> -->
            <function><en>Crawfish Hatchery Tank</en></function>
        </functions>
        <!-- <image>store/store_crawfishHatchery.png</image> -->
        <image>store/store_chemicalProduction.png</image>
        <price>20000</price>
        <dailyUpkeep>40</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PRI</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Production</tab>
        </brush>
        <vertexBufferMemoryUsage>432896</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>64256</indexBufferMemoryUsage>
        <textureMemoryUsage>11075584</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/crawfishHatchery.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

	<!-- <customAttributes>
		<animatedPlanes>true</animatedPlanes>
	</customAttributes> -->

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
<!--         <paintAreas>
            <paintArea startNode="levelAreaStart01" heightNode="levelAreaWidth01" widthNode="levelAreaHeight01" groundType="dirt"/>
        </paintAreas> -->
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="dirt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <triggerMarkers>
        <triggerMarker node="warningStripes" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
    </triggerMarkers>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <lights>
        <group weatherRequiredFlags="NIGHT"/>

        <sharedLight linkNode="linkNode01" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode02" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode03" filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode04" filename="$data/shared/assets/lights/lizard/buildings/industrialLight05.xml" groupIndex="1"/>
        <sharedLight linkNode="linkNode05" filename="$data/shared/assets/lights/lizard/buildings/industrialLight05.xml" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>
    </lights>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker"/>
    </hotspots>

    <infoTrigger triggerNode="infoTrigger"/>

    <productionPoint>
        <productions>
            <!-- <production id="crawfishBroodstock" name="$l10n_fillType_crawfishBroodstock" cyclesPerHour="2" costsPerActiveHour="16"> -->
            <production id="crawfishBroodstock" name="Crawfish Broodstock" cyclesPerHour="2" costsPerActiveHour="16">
                <inputs>
                    <input fillType="CRAWFISH" amount="150" />
                    <input fillType="WATER" amount="100" />
                    <!-- put feed here. grains, veggies, meat -->
                    <input fillType="EMPTYPALLET" amount="600" />
                </inputs>
                <outputs>
                    <output fillType="CRAWFISH_BROODSTOCK" amount="600" /> <!-- 28,800 per day -->
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <!-- INPUT -->
            <capacity fillType="CRAWFISH"   capacity="20000" />
            <capacity fillType="WATER"      capacity="40000" />
            <!-- put feed here -->
            <capacity fillType="EMPTYPALLET"    capacity="80000" />
            <!-- OUTPUT -->
            <capacity fillType="CRAWFISH_BROODSTOCK"    capacity="20000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="unloadTriggerAINode" fillTypes="WATER CRAWFISH" > <!-- put feed here -->
                <!-- <fillTypeConversion ratio="0.77" outgoingFillType="RICE_DRY" incomingFillType="RICELONGGRAIN_DRY" /> -->

                <!-- <waterPlane node="waterPlane" minY="-0.682" maxY="0.0" minScale="0 0 0.95" maxScale="0 0 1" changeVisibility="true" /> -->
            </unloadTrigger>

            <palletTrigger triggerNode="palletTrigger" aiNode="palletTriggerAINode" fillTypes="CRAWFISH EMPTYPALLET" > <!-- put feed here -->
                <!-- <foodPlane node="crawfishPlane01" minY="-0.318" maxY="0.0" changeVisibility="true" defaultFillType="CRAWFISH" /> -->
            </palletTrigger>

        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="spawnAreaStart01" endNode="spawnAreaEnd01" />  <!-- fillTypes="CRAWFISH_BROODSTOCK" -->
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <!-- <idle   template="dairyIdle" linkNode="0>" /> -->
            <idle />
            <active template="dairyWork" linkNode="0>" volumeScale="0.2" />
        </sounds>

    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>2|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>2|1|1" />

        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="spawnAreaStart01" node="0>5|0" />
        <i3dMapping id="spawnAreaEnd01" node="0>5|0|0" />

        <i3dMapping id="playerTrigger" node="0>6|0" />
        <i3dMapping id="playerTriggerMarker" node="0>6|0|0" />
        <i3dMapping id="infoTrigger" node="0>6|1" />

        <i3dMapping id="sellingStation" node="0>7" />
        <i3dMapping id="exactFillRootNode" node="0>7|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>7|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>7|2" />
        <i3dMapping id="palletTrigger" node="0>7|3" />
        <i3dMapping id="palletTriggerAINode" node="0>7|4" />
        <i3dMapping id="markerPallet" node="0>7|4" />
        <i3dMapping id="waterPlane" node="0>7|6" />
        <i3dMapping id="crawfishPlane01" node="0>7|7" />

        <i3dMapping id="warningStripes" node="0>8" />

        <i3dMapping id="realLightsLow"  node="0>9|0|0" />
        <i3dMapping id="realLightsHigh" node="0>9|0|1" />
        <i3dMapping id="linkNode01"     node="0>9|1|0" />
        <i3dMapping id="linkNode02"     node="0>9|1|1" />
        <i3dMapping id="linkNode03"     node="0>9|1|2" />
        <i3dMapping id="linkNode04"     node="0>9|1|3" />
        <i3dMapping id="linkNode05"     node="0>9|1|4" />
    </i3dMappings>
</placeable>
