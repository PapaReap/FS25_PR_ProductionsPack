            <production id="WOODEN_SHELF" name="$l10n_fillType_wooden_Shelf" cyclesPerHour="3" costsPerActiveHour="1">
                <inputs>
                    <input fillType="PLANKS" amount="800" />
                    <input fillType="MDFBOARDS" amount="200" />
                </inputs>
                <outputs>
                    <output fillType="WOODEN_SHELF" amount="1000" />
                    <output fillType="WOODCHIPS" amount="300" />
                </outputs>
            </production>

            <production id="DOGHOUSE" name="$l10n_fillType_doghouse" cyclesPerHour="2" costsPerActiveHour="1">
                <inputs>
                    <!-- Needs planks or boards -->
                    <input fillType="BOARDS" amount="2500" />
                    <input fillType="PLANKS" amount="800" />
                </inputs>
                <outputs>
                    <output fillType="WOODCHIPS" amount="300" />
                    <output fillType="DOGHOUSE" amount="1000" />
                </outputs>
            </production>

            <production id="carvings" name="$l10n_fillType_carvings" cyclesPerHour="2" costsPerActiveHour="3">
                <inputs>
