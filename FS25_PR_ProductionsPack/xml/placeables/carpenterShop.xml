        <sellingStation node="sellingStation" supportsExtension="false">
            <palletTrigger triggerNode="palletTrigger" fillTypes="BOARDS PLANKS WOODBEAM MDFBOARDS OSBBOARDS" aiNode="unloadTriggerAINode"/>
            <woodTrigger   triggerNode="woodTrigger"   fillTypes="WOOD"          aiNode="unloadTriggerAINode" activationTriggerNode="woodSellTrigger" />
            <palletTrigger triggerNode="palletWoodTrigger" fillTypes="WOOD"/>
        </sellingStation>

        <loadingStation node="loadingStation" supportsExtension="false">
            <loadTrigger triggerNode="loadingTrigger" fillLitersPerSecond="1000" dischargeNode="dischargeNode" fillTypes="WOODCHIPS">
                <effectNode effectClass="PipeEffect" effectNode="pipeEffect"      materialType="pipe"           fadeTime="0.5" maxBending="0" shapeScaleSpread="1 1 1 0" controlPoint="7.25 0 0 0"/>
                <effectNode                          effectNode="pipeEffectSmoke" materialType="unloadingSmoke" fadeTime="0.5" />
            </loadTrigger>
        </loadingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01" fillTypes="FURNITURE WOODEN_SHELF CARVINGS TOYS"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02" fillTypes="EMPTYPALLET"/>
                <spawnPlace startNode="palletAreaStart03" endNode="palletAreaEnd03" fillTypes="PREFABWALL EMPTYPALLETSFILLABLE"/>
                <spawnPlace startNode="palletAreaStart04" endNode="palletAreaEnd04" fillTypes="BARREL BUCKET BATHTUB DOGHOUSE"/>
                <!-- "WOODEN_BOX_A BAKERY_CASES CHEESE_CASES" -->
            </spawnPlaces>
        </palletSpawner>

