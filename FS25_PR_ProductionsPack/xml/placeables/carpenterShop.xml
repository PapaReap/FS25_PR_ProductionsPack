    <productionPoint>
        <productions sharedThroughputCapacity="false">
        <!-- <productions> -->
            <!-- FURNITURE USE BOARDS & MDF -->
            <production id="furniture" name="$l10n_fillType_furniture" cyclesPerHour="14" costsPerActiveHour="3">
                <inputs>
                    <input fillType="BOARDS" amount="90" />
                    <input fillType="MDFBOARDS" amount="50" />
                </inputs>
                <outputs>
                    <output fillType="FURNITURE" amount="140" />
                    <output fillType="WOODCHIPS" amount="30" />
                </outputs>
            </production>

            <!-- MAKE BOARDS FROM PLANKS -->
            <production id="boards" name="$l10n_fillType_boards" cyclesPerHour="20" costsPerActiveHour="2">
                <inputs>
                    <input fillType="PLANKS" amount="4100" />
                </inputs>
                <outputs>
                    <output fillType="BOARDS"    amount="2050" />
                    <output fillType="WOODCHIPS" amount="100" />
                </outputs>
            </production>

            <production id="prefabWall" name="$l10n_fillType_prefabWall" cyclesPerHour="7" costsPerActiveHour="2">
                <inputs>
                    <input fillType="BOARDS" amount="200" />
                    <input fillType="PLANKS" amount="100" />
                    <input fillType="WOODBEAM" amount="50" />
                    <input fillType="OSBBOARDS" amount="100" />
                    <!-- osb, planks long, planks, beam (boards are the shorter, planks are long) -->
                </inputs>
                <outputs>
                    <output fillType="PREFABWALL" amount="400" />
                    <output fillType="WOODCHIPS" amount="50" />
                </outputs>
            </production>

            <production id="barrel" name="$l10n_fillType_barrel" cyclesPerHour="4" costsPerActiveHour="2">
                <inputs>
                    <input fillType="BOARDS" amount="250" />
                </inputs>
                <outputs>
                    <output fillType="BARREL"    amount="248" />
                    <output fillType="WOODCHIPS" amount="60" />
                </outputs>
            </production>

            <production id="bucket" name="$l10n_fillType_bucket" cyclesPerHour="6" costsPerActiveHour="2">
                <inputs>
                    <input fillType="BOARDS" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="BUCKET"    amount="137" />
                    <output fillType="WOODCHIPS" amount="60" />
                </outputs>
            </production>

            <production id="bathtub" name="$l10n_fillType_bathtub" cyclesPerHour="3" costsPerActiveHour="2">
                <inputs>
                    <input fillType="BOARDS" amount="50" />
                    <input fillType="PLANKS" amount="45" />
                </inputs>
                <outputs>
                    <output fillType="BATHTUB"   amount="130" />
                    <output fillType="WOODCHIPS" amount="60" />
                </outputs>
            </production>

            <production id="emptyPallet" name="$l10n_fillType_emptyPallet" cyclesPerHour="25" costsPerActiveHour="3">
                <inputs>
                    <input fillType="BOARDS" amount="250" />
                    <input fillType="WOODBEAM" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="EMPTYPALLET" amount="8000" />
                    <output fillType="WOODCHIPS" amount="200" />
                </outputs>
            </production>

            <production id="emptyPalletsFillable" name="$l10n_fillType_emptyPalletsFillable" cyclesPerHour="5" costsPerActiveHour="25">
                <inputs>
                    <input fillType="BOARDS" amount="0.375" />
                    <input fillType="PLANKS" amount="0.200" />
                    <input fillType="WOODBEAM" amount="0.120" />
                </inputs>
                <outputs>
                    <output fillType="EMPTYPALLETSFILLABLE" amount="12" />
                    <output fillType="WOODCHIPS" amount="0.300" />
                </outputs>
            </production>

