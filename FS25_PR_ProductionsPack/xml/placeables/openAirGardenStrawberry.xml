        <animatedObject saveId="GreenhouseUp" >
            <animation duration="3">
                <part node="leverGreenhouse">
                    <keyFrame time="0.0" rotation="60 0 0"/>
                    <keyFrame time="0.1" rotation="-60 0 0"/>
                </part>
                <part node="greenhouse">
                    <keyFrame time="0.0" translation="0 -5 0"/>
                    <keyFrame time="1.0" translation="0 0 0"/>
                </part>
                <part node="greenhouseDoors">
                    <keyFrame time="0.0" translation="0 -5 0"/>
                    <keyFrame time="1.0" translation="0 0 0"/>
                </part>

            </animation>
            <controls triggerNode="greenhouseTrigger" posAction="ACTIVATE_HANDTOOL" posText="l10nGreenhouseUp" negText="l10nGreenhouseDown" />
            <sounds>
                <moving file="$data/sounds/tools/milkrobot/milkrobot_door_01.wav" loops="0" linkNode="leverGreenhouse" volume="0.8" radius="5" innerRadius="3" fadeOut="0.25"/>
                <posEnd file="$data/sounds/doors/doorWoodOpen_01.wav" linkNode="leverGreenhouse" volume="0.8" radius="5" innerRadius="3" />
                <negEnd file="$data/sounds/doors/doorWoodClose_01.wav" linkNode="leverGreenhouse" volume="0.8" radius="5" innerRadius="3" />
            </sounds>
