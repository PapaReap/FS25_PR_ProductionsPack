<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="greenhouse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_openAirGardenStrawberry</name>
        <functions>
            <function>$l10n_function_openAirGardenStrawberry</function>
        </functions>
        <image>store/store_openAirGarden.dds</image>
        <price>8000</price>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>placeable</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>PapaReap_Greenhouse</tab>
        </brush>
        <canBeSold>true</canBeSold>
        <storeIconRendering>
            <settings cameraXRot="-20" cameraYRot="30" advancedBoundingBox="true"/>
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
        <vertexBufferMemoryUsage>302080</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>75264</indexBufferMemoryUsage>
        <textureMemoryUsage>3997696</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <filename>i3d/placeables/openAirGarden/openAirGarden.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End" />
        </testAreas>
        <sounds>
            <place template="medImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="1" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="gravel"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End" />
        </updateAreas>
        <splines>
            <spline node="aiLoadingSpline" />
        </splines>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="teleportNode" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="warningStripes" />
        <triggerMarker node="markerLoading"   filename="$data/shared/assets/marker/markerIconLoad.i3d" adjustToGround="true" />
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" adjustToGround="true" />
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d"  adjustToGround="true" />
    </triggerMarkers>

    <greenhouse>
        <plants>
            <plant fillType="strawberry"    xmlFilename="xml/fruit/strawberry.xml" />
        </plants>

        <plantSpaces>
            <spacesParent node="plantNodes" useRandomYRot="false" />
        </plantSpaces>

        <sounds>
            <watering template="defaultSprayer" linkNode="0>" loops="0" />
        </sounds>

    </greenhouse>

    <productionPoint>
        <productions>
            <production id="strawberrySF" name="%s %s %s + %s" params="$l10n_fillType_strawberry|$l10n_l10nWith|$l10n_fillType_seeds|$l10n_fillType_fertilizer" cyclesPerHour="2" costsPerActiveHour="0.1">
                <inputs>
                    <input fillType="WATER" amount="44" />
                    <input fillType="SEEDS" amount="1" />
                    <input fillType="FERTILIZER" amount="1" />
                    <input fillType="EMPTYPALLET" amount="176" />
                </inputs>
                <outputs>
                    <output fillType="STRAWBERRY" amount="176" />
                </outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="true" hideFromPricesMenu="true">
            <unloadTrigger exactFillRootNode="unloadTrigger" fillTypes="WATER SEEDS FERTILIZER MANURE" aiNode="unloadTriggerAINode" >
                <fillTypeConversion ratio="0.2" outgoingFillType="fertilizer" incomingFillType="manure" />
            </unloadTrigger>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="EMPTYPALLET"/>
        </sellingStation>

        <palletSpawner node="palletSpawner">
            <spawnPlaces>
                <spawnPlace startNode="spawnPlace1Start" />
            </spawnPlaces>
        </palletSpawner>

        <storage node="storage" isExtension="false" fillTypes="WATER SEEDS FERTILIZER" >
            <capacity fillType="WATER"          capacity="60000" />
            <capacity fillType="SEEDS"          capacity="20000" />
            <capacity fillType="FERTILIZER"     capacity="20000" />
            <capacity fillType="EMPTYPALLET"    capacity="40000" />

            <capacity fillType="STRAWBERRY"     capacity="60000" />
        </storage>

        <playerTrigger node="playerTrigger" />
    </productionPoint>

    <animatedObjects>
        <animatedObject saveId="door1" >
            <animation duration="3">
                <part node="door1Left">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 -90 0"/>
                </part>
                <part node="door1Right">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="0.9" rotation="0 90 0"/>
                </part>
                <part node="door1LeftSpring">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 -90 0"/>
                </part>
                <part node="door1RightSpring">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="0.9" rotation="0 90 0"/>
                </part>

                <part node="doorFenceColi1Left">
                    <keyFrame time="0.1" rotation="0 0 0"/>
                    <keyFrame time="1.0" rotation="0 -90 0"/>
                </part>
                <part node="doorFenceColi1Right">
                    <keyFrame time="0.0" rotation="0 0 0"/>
                    <keyFrame time="0.9" rotation="0 90 0"/>
                </part>

            </animation>
            <controls triggerNode="door1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openDoor" negText="action_closeDoor" />
            <sounds>
                <moving linkNode="door1" template="glassDoorLoop"/>
                <negEnd linkNode="door1" template="metalDoorsClose" />
            </sounds>
        </animatedObject>
