    <solarPanels>
        <solarPanelsConfigurations title="$l10n_gardenConfiguration">
            <solarPanelsConfiguration name="$l10n_FenceGardenBeds" isActive="true" >
                <objectChange node="fences" visibilityActive="true"/>
                <objectChange node="doorFences" visibilityActive="true"/>
                <objectChange node="noFence" visibilityActive="false"/>
                <objectChange node="gardenBeds" visibilityActive="true"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_NoFenceGardenBeds" isActive="false" price="-1000">
                <objectChange node="fences" visibilityActive="false"/>
                <objectChange node="doorFences" visibilityActive="false"/>
                <objectChange node="noFence" visibilityActive="true"/>
                <objectChange node="gardenBeds" visibilityActive="true"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_FenceNoGardenBeds" isActive="false" price="-1000">
                <objectChange node="fences" visibilityActive="true"/>
                <objectChange node="doorFences" visibilityActive="true"/>
                <objectChange node="noFence" visibilityActive="false"/>
                <objectChange node="gardenBeds" visibilityActive="false"/>
            </solarPanelsConfiguration>
            <solarPanelsConfiguration name="$l10n_NoFenceNoGardenBeds" isActive="false" price="-2000">
                <objectChange node="fences" visibilityActive="false"/>
                <objectChange node="doorFences" visibilityActive="false"/>
                <objectChange node="noFence" visibilityActive="true"/>
                <objectChange node="gardenBeds" visibilityActive="false"/>
            </solarPanelsConfiguration>
        </solarPanelsConfigurations>
    </solarPanels>

