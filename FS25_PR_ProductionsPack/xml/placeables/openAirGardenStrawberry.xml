                </part>

            </animation>
            <controls triggerNode="collisionTrigger" posAction="ACTIVATE_HANDTOOL" posText="l10nColiUp" negText="l10nColiDown" />
            <sounds>
                <moving file="$data/sounds/tools/milkrobot/milkrobot_door_01.wav" loops="0" linkNode="leverCollision" volume="0.8" radius="5" innerRadius="3" fadeOut="0.25"/>
                <posEnd file="$data/sounds/doors/doorWoodOpen_01.wav" linkNode="leverCollision" volume="0.8" radius="5" innerRadius="3" />
