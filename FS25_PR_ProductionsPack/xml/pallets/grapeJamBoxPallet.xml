<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_fillType_grape_jam</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>PRI</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>

        <storeIconRendering>
            <settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
        </storeIconRendering>
        <vertexBufferMemoryUsage>36608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>6912</indexBufferMemoryUsage>
        <textureMemoryUsage>983040</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/grapeJamPallet.i3d</filename>
        <size width="1.3" length="0.9" height="0.8" />
        <canBeReset>false</canBeReset>
        <components maxMass="400">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="GRAPE_JAM" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <pallet fillUnitIndex="1" linkNode="grapeJamPallet_component1">
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletMiddle_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.dds"/>
        <content>
            <object node="grapeJamBox01" tensionBeltNode="grapeJamBox_Tension01"/>
            <object node="grapeJamBox02" tensionBeltNode="grapeJamBox_Tension02"/>
            <object node="grapeJamBox03" tensionBeltNode="grapeJamBox_Tension03"/>
            <object node="grapeJamBox04" tensionBeltNode="grapeJamBox_Tension04"/>
            <object node="grapeJamBox05" tensionBeltNode="grapeJamBox_Tension05"/>
            <object node="grapeJamBox06" tensionBeltNode="grapeJamBox_Tension06"/>
            <object node="grapeJamBox07" tensionBeltNode="grapeJamBox_Tension07"/>
            <object node="grapeJamBox08" tensionBeltNode="grapeJamBox_Tension08"/>
            <object node="grapeJamBox09" tensionBeltNode="grapeJamBox_Tension09"/>
            <object node="grapeJamBox10" tensionBeltNode="grapeJamBox_Tension10"/>
            <object node="grapeJamBox11" tensionBeltNode="grapeJamBox_Tension11"/>
            <object node="grapeJamBox12" tensionBeltNode="grapeJamBox_Tension12"/>
        </content>

        <sounds>
            <unload template="palletsFillPaper" pitchScale="0.8" />
        </sounds>
    </pallet>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.75" jointTransY="0.11" jointLimitToRotY="true"/>

    <i3dMappings>
        <i3dMapping id="grapeJamPallet_component1" node="0>" />
        <i3dMapping id="dynamicMountTrigger" node="0>0" />
        <i3dMapping id="grapeJamBox01" node="0>1|0" />
        <i3dMapping id="grapeJamBox_Tension01" node="0>1|0|0" />
        <i3dMapping id="grapeJamBox02" node="0>1|1" />
        <i3dMapping id="grapeJamBox_Tension02" node="0>1|1|0" />
        <i3dMapping id="grapeJamBox03" node="0>1|2" />
        <i3dMapping id="grapeJamBox_Tension03" node="0>1|2|0" />
        <i3dMapping id="grapeJamBox04" node="0>1|3" />
        <i3dMapping id="grapeJamBox_Tension04" node="0>1|3|0" />
        <i3dMapping id="grapeJamBox05" node="0>1|4" />
        <i3dMapping id="grapeJamBox_Tension05" node="0>1|4|0" />
        <i3dMapping id="grapeJamBox06" node="0>1|5" />
        <i3dMapping id="grapeJamBox_Tension06" node="0>1|5|0" />
        <i3dMapping id="grapeJamBox07" node="0>1|6" />
