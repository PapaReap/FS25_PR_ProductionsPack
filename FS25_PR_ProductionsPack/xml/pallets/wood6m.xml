<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_shopItem_wood6m</name>
        <functions>
            <function>$l10n_function_wood</function>
        </functions>
        <specs>
            <weight ignore="true"/>
        </specs>
        <image>store/pallets/store_wood.png</image>
        <price>100</price>
        <allowLeasing>false</allowLeasing>
        <canBeSold>false</canBeSold>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <category>shippingContainers</category>
        <financeCategory>OTHER</financeCategory>
        <showInStore>false</showInStore>
        <vertexBufferMemoryUsage>8960</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>3584</indexBufferMemoryUsage>
        <textureMemoryUsage>1507328</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_wood</typeDesc>
        <filename>i3d/pallets/wood6m.i3d</filename>
        <size width="6" length="0.6" height="0.6" />
        <input allowed="false"/>
        <canBeReset>false</canBeReset>
        <components maxMass="920">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="700" />
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration name="$l10n_configuration_valueDefault">
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="wood" capacity="960" ignoreFillLimit="true">
                        <fillRootNode node="0>" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <dischargeable requiresTipOcclusionArea="false">
        <dischargeNode node="raycastNode" emptySpeed="100" fillUnitIndex="1" maxDistance="6" canStartDischargeAutomatically="true">
            <raycast useWorldNegYDirection="true" />
            <info width="0.4" length="0.4" />
            <activationTrigger node="dischargeActivationTrigger" />
            <effects>
            </effects>
        </dischargeNode>
    </dischargeable>

    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="200"/>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="1.09" jointTransY="0.097" jointLimitToRotY="true"/>

    <tensionBeltObject>
        <meshNodes>
            <meshNode node="log01Shape"/>
        </meshNodes>
    </tensionBeltObject>

    <i3dMappings>
        <i3dMapping id="dynamicMountTrigger" node="0>0" />
        <i3dMapping id="raycastNode" node="0>1|0" />
        <i3dMapping id="fillTrigger" node="0>1|1" />
        <i3dMapping id="dischargeActivationTrigger" node="0>1|3" />
        <i3dMapping id="bigBagPallet_vis" node="0>2|0" />
        <i3dMapping id="log01Shape" node="0>2|1" />
    </i3dMappings>
</vehicle>
