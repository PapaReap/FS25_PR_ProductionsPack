<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_fillType_chocolate_fondant</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>PRI</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>

        <storeIconRendering>
            <settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
        </storeIconRendering>
        <vertexBufferMemoryUsage>36608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>6912</indexBufferMemoryUsage>
        <textureMemoryUsage>983040</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/chocolateFondantPallet.i3d</filename>
        <size width="1.3" length="0.9" height="0.8" />
        <canBeReset>false</canBeReset>
        <components maxMass="400">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <!-- <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="CHOCOLATE_FONDANT" capacity="1000"/> -->
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="CHOCOLATE_FONDANT" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <pallet fillUnitIndex="1" linkNode="chocolateFondantPallet_component1">
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletMiddle_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.dds"/>
        <content>
            <object node="chocolateFondantBox01" tensionBeltNode="chocolateFondantBox_Tension01"/>
            <object node="chocolateFondantBox02" tensionBeltNode="chocolateFondantBox_Tension02"/>
            <object node="chocolateFondantBox03" tensionBeltNode="chocolateFondantBox_Tension03"/>
            <object node="chocolateFondantBox04" tensionBeltNode="chocolateFondantBox_Tension04"/>
            <object node="chocolateFondantBox05" tensionBeltNode="chocolateFondantBox_Tension05"/>
            <object node="chocolateFondantBox06" tensionBeltNode="chocolateFondantBox_Tension06"/>
            <object node="chocolateFondantBox07" tensionBeltNode="chocolateFondantBox_Tension07"/>
            <object node="chocolateFondantBox08" tensionBeltNode="chocolateFondantBox_Tension08"/>
            <object node="chocolateFondantBox09" tensionBeltNode="chocolateFondantBox_Tension09"/>
            <object node="chocolateFondantBox10" tensionBeltNode="chocolateFondantBox_Tension10"/>
            <object node="chocolateFondantBox11" tensionBeltNode="chocolateFondantBox_Tension11"/>
            <object node="chocolateFondantBox12" tensionBeltNode="chocolateFondantBox_Tension12"/>
        </content>

        <sounds>
            <unload template="palletsFillPaper" pitchScale="0.8" />
        </sounds>
    </pallet>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.75" jointTransY="0.11" jointLimitToRotY="true"/>

    <i3dMappings>
        <i3dMapping id="chocolateFondantPallet_component1" node="0>" />
        <i3dMapping id="dynamicMountTrigger" node="0>0" />
        <i3dMapping id="chocolateFondantBox01" node="0>1|0" />
        <i3dMapping id="chocolateFondantBox_Tension01" node="0>1|0|0" />
        <i3dMapping id="chocolateFondantBox02" node="0>1|1" />
        <i3dMapping id="chocolateFondantBox_Tension02" node="0>1|1|0" />
        <i3dMapping id="chocolateFondantBox03" node="0>1|2" />
