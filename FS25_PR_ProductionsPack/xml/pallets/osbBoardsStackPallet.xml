    <storeData>
        <name>$l10n_fillType_osbBoards</name>
        <image>store/pallets/store_osbBoardsStackPallet.dds</image>
        <price>1790</price>
        <category>pallets</category>
        <brand>NONE</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>
        <vertexBufferMemoryUsage>8704</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>2560</indexBufferMemoryUsage>
        <textureMemoryUsage>1310720</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>

        <storeIconRendering>
            <settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
        </storeIconRendering>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/osbPanelsPallet.i3d</filename>
        <size width="2.6" length="0.9" height="0.8" lengthOffset="0" />
        <canBeReset>false</canBeReset>
        <components maxMass="100">
            <component centerOfMass="0 0.2 0" solverIterationCount="10" mass="50"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
		<supportsPickUp>true</supportsPickUp>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true" >
                    <fillUnit unitTextOverride="$l10n_unit_pieces" fillTypes="OSBBOARDS" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>
	
	<dischargeable requiresTipOcclusionArea="false">
	    <dischargeNode node="raycastNode" emptySpeed="500" fillUnitIndex="1" maxDistance="6" canStartDischargeAutomatically="true">
		    <raycast useWorldNegYDirection="true" />
			<info width="0.4" length="0.4" />
			<activationTrigger nodee="dischargeActivationTrigger" />
		</dischargeNode>
	</dischargeable>

    <pallet fillUnitIndex="1" node="planksPallet_vis">
