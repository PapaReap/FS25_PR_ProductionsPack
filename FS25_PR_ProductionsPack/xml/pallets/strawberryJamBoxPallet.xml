<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="pallet" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>$l10n_fillType_strawberry_jam</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>PRI</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>

        <storeIconRendering>
            <settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
        </storeIconRendering>
        <vertexBufferMemoryUsage>36608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>6912</indexBufferMemoryUsage>
        <textureMemoryUsage>983040</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/strawberryJamPallet.i3d</filename>
        <size width="1.3" length="0.9" height="0.8" />
        <canBeReset>false</canBeReset>
        <components maxMass="400">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <!-- <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="STRAWBERRY_JAM" capacity="1000"/> -->
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="STRAWBERRY_JAM" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <pallet fillUnitIndex="1" linkNode="strawberryJamPallet_component1">
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletMiddle_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.dds"/>
        <content>
            <object node="strawberryJamBox01" tensionBeltNode="strawberryJamBox_Tension01"/>
            <object node="strawberryJamBox02" tensionBeltNode="strawberryJamBox_Tension02"/>
            <object node="strawberryJamBox03" tensionBeltNode="strawberryJamBox_Tension03"/>
            <object node="strawberryJamBox04" tensionBeltNode="strawberryJamBox_Tension04"/>
            <object node="strawberryJamBox05" tensionBeltNode="strawberryJamBox_Tension05"/>
            <object node="strawberryJamBox06" tensionBeltNode="strawberryJamBox_Tension06"/>
            <object node="strawberryJamBox07" tensionBeltNode="strawberryJamBox_Tension07"/>
            <object node="strawberryJamBox08" tensionBeltNode="strawberryJamBox_Tension08"/>
            <object node="strawberryJamBox09" tensionBeltNode="strawberryJamBox_Tension09"/>
            <object node="strawberryJamBox10" tensionBeltNode="strawberryJamBox_Tension10"/>
            <object node="strawberryJamBox11" tensionBeltNode="strawberryJamBox_Tension11"/>
            <object node="strawberryJamBox12" tensionBeltNode="strawberryJamBox_Tension12"/>
        </content>

        <sounds>
            <unload template="palletsFillPaper" pitchScale="0.8" />
        </sounds>
    </pallet>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.75" jointTransY="0.11" jointLimitToRotY="true"/>

    <i3dMappings>
        <i3dMapping id="strawberryJamPallet_component1" node="0>" />
        <i3dMapping id="dynamicMountTrigger" node="0>0" />
        <i3dMapping id="strawberryJamBox01" node="0>1|0" />
        <i3dMapping id="strawberryJamBox_Tension01" node="0>1|0|0" />
        <i3dMapping id="strawberryJamBox02" node="0>1|1" />
        <i3dMapping id="strawberryJamBox_Tension02" node="0>1|1|0" />
