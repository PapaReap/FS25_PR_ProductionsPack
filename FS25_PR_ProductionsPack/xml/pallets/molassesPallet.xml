    <storeData>
        <name>$l10n_fillType_molasses</name>
        <functions>
            <function>$l10n_function_molasses</function>
        </functions>
        <specs>
            <capacity>1000</capacity>
            <fillTypes>MOLASSES</fillTypes>
            <weight ignore="true"/>
        </specs>
        <image>store/pallets/store_molassesPallet.png</image>
        <price>1500</price>
        <category>PapaReap_Pallet</category>
        <brand>PRI</brand>
        <showInStore>true</showInStore>
        <canBeSold>true</canBeSold>
        <financeCategory>OTHER</financeCategory>
        <allowLeasing>false</allowLeasing>
        <vertexBufferMemoryUsage>80640</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>17664</indexBufferMemoryUsage>
        <textureMemoryUsage>2490368</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/molassesPallet.i3d</filename>
        <size width="1.3" length="0.9" height="0.8" />
        <canBeReset>false</canBeReset>
        <components maxMass="400">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits removeVehicleIfEmpty="true">
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="MOLASSES" startFillType="MOLASSES" capacity="1000" startFillLevel="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

