    <storeData>
        <name>$l10n_fillType_chocolate_mousse</name>
        <image>$data/store/store_empty.png</image>
        <category>pallets</category>
        <brand>PRI</brand>
        <showInStore>false</showInStore>
        <canBeSold>false</canBeSold>
        <financeCategory>OTHER</financeCategory>

        <storeIconRendering>
            <settings centerIcon="true" cameraXRot="-15" cameraYRot="35"/>
        </storeIconRendering>
        <vertexBufferMemoryUsage>36608</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>6912</indexBufferMemoryUsage>
        <textureMemoryUsage>983040</textureMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_pallet</typeDesc>
        <filename>i3d/pallets/chocolateMoussePallet.i3d</filename>
        <size width="1.3" length="0.9" height="0.8" />
        <canBeReset>false</canBeReset>
        <components maxMass="400">
            <component centerOfMass="0 0.1 0" solverIterationCount="10" mass="60"/>
        </components>
        <showInVehicleMenu>false</showInVehicleMenu>
        <mapHotspot available="false" />
        <input allowed="false"/>
    </base>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <!-- <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="CHOCOLATE_MOUSSE" capacity="1000"/> -->
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="CHOCOLATE_MOUSSE" capacity="1000" ignoreFillLimit="true"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <pallet fillUnitIndex="1" linkNode="chocolateMoussePallet_component1">
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletNew_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletMiddle_diffuse.dds"/>
        <texture diffuse="$data/objects/pallets/shared/euroPallet/euroPalletOld_diffuse.dds"/>
        <content>
            <object node="chocolateMousseBox01" tensionBeltNode="chocolateMousseBox_Tension01"/>
            <object node="chocolateMousseBox02" tensionBeltNode="chocolateMousseBox_Tension02"/>
            <object node="chocolateMousseBox03" tensionBeltNode="chocolateMousseBox_Tension03"/>
            <object node="chocolateMousseBox04" tensionBeltNode="chocolateMousseBox_Tension04"/>
            <object node="chocolateMousseBox05" tensionBeltNode="chocolateMousseBox_Tension05"/>
            <object node="chocolateMousseBox06" tensionBeltNode="chocolateMousseBox_Tension06"/>
            <object node="chocolateMousseBox07" tensionBeltNode="chocolateMousseBox_Tension07"/>
            <object node="chocolateMousseBox08" tensionBeltNode="chocolateMousseBox_Tension08"/>
            <object node="chocolateMousseBox09" tensionBeltNode="chocolateMousseBox_Tension09"/>
            <object node="chocolateMousseBox10" tensionBeltNode="chocolateMousseBox_Tension10"/>
            <object node="chocolateMousseBox11" tensionBeltNode="chocolateMousseBox_Tension11"/>
            <object node="chocolateMousseBox12" tensionBeltNode="chocolateMousseBox_Tension12"/>
        </content>

        <sounds>
            <unload template="palletsFillPaper" pitchScale="0.8" />
        </sounds>
    </pallet>

    <dynamicMount triggerNode="dynamicMountTrigger" triggerForceAcceleration="4" additionalMountDistance="0.75" jointTransY="0.11" jointLimitToRotY="true"/>

    <i3dMappings>
        <i3dMapping id="chocolateMoussePallet_component1" node="0>" />
        <i3dMapping id="dynamicMountTrigger" node="0>0" />
        <i3dMapping id="chocolateMousseBox01" node="0>1|0" />
        <i3dMapping id="chocolateMousseBox_Tension01" node="0>1|0|0" />
        <i3dMapping id="chocolateMousseBox02" node="0>1|1" />
